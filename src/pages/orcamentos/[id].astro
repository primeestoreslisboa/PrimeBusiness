---
import Layout from '../../layouts/Layout.astro';
import OrcamentoForm from '../../components/OrcamentoForm.astro';
import { getDb } from '../../lib/db';
import { getIvaRate } from '../../lib/settings';
import { loadOrcamento, num, isLocked } from '../../lib/orcamentos';

const user = Astro.locals.user;
const sql = getDb();
const { id } = Astro.params;

const loaded = await loadOrcamento(sql, id!);
if (!loaded) return Astro.redirect('/orcamentos?error=not_found');
const { orc, itens } = loaded;

const ivaRate = await getIvaRate(23);
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
const errMsg = Astro.url.searchParams.get('msg');
const locked = isLocked(orc.status);

const eur = (n: number) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

const statusInfo: Record<string, { label: string; cls: string }> = {
  rascunho: { label: 'Rascunho', cls: 'bg-gray-100 text-gray-600' },
  enviado: { label: 'Enviado', cls: 'bg-blue-100 text-blue-700' },
  aprovado: { label: 'Aprovado', cls: 'bg-green-100 text-green-700' },
  rejeitado: { label: 'Rejeitado', cls: 'bg-red-100 text-red-700' },
};
const st = statusInfo[orc.status] ?? statusInfo.rascunho;

const successMessages: Record<string, string> = {
  created: 'Orçamento criado com sucesso.',
  updated: 'Orçamento atualizado.',
  email_sent: 'Orçamento enviado por email (PDF anexado).',
  status: 'Estado atualizado.',
};
const errorMessages: Record<string, string> = {
  validation: 'Preencha o nome do cliente.',
  locked: 'Este orçamento está fechado e não pode ser editado.',
  no_email: 'Não há email de destino. Adicione um email ao cliente.',
  no_phone: 'Não há telefone de destino. Adicione um telefone ao cliente.',
  no_horario: 'Indique a data e hora do agendamento.',
  agendamento_incompleto: 'Para agendar é preciso telefone, morada e localidade do cliente.',
  email_failed: `Falha ao enviar email${errMsg ? `: ${errMsg}` : '.'}`,
  server: 'Ocorreu um erro no servidor.',
};
---
<Layout title={orc.numero ?? `Orçamento #${orc.id}`} user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center gap-3 mb-4">
      <a href="/orcamentos" class="text-gray-400 hover:text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>
      <div class="flex-1">
        <h1 class="text-xl font-bold text-gray-800">{orc.numero ?? `Orçamento #${orc.id}`}</h1>
        <p class="text-xs text-gray-400">{orc.cliente_nome}</p>
      </div>
      <span class={`text-xs px-2 py-1 rounded ${st.cls}`}>{st.label}</span>
    </div>

    {success && <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">✅ {successMessages[success] ?? 'Operação realizada.'}</div>}
    {error && <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">❌ {errorMessages[error] ?? 'Ocorreu um erro.'}</div>}

    <!-- RESUMO + AÇÕES -->
    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 mb-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-500">Total</span>
        <span class="text-lg font-bold text-red-700">{eur(num(orc.total))} €</span>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <a href={`/api/orcamentos-diretos/${orc.id}/pdf`} target="_blank" rel="noopener"
           class="flex items-center justify-center gap-2 py-2.5 rounded-lg text-sm font-semibold bg-gray-800 hover:bg-gray-900 text-white transition">
          📄 Ver / Descarregar PDF
        </a>

        <form method="POST" action={`/api/orcamentos-diretos/${orc.id}`}>
          <input type="hidden" name="action" value="send_whatsapp" />
          <button type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 rounded-lg text-sm font-semibold bg-green-600 hover:bg-green-700 text-white transition">
            💬 Enviar por WhatsApp
          </button>
        </form>
      </div>

      <!-- Email -->
      <form method="POST" action={`/api/orcamentos-diretos/${orc.id}`} class="mt-3 flex gap-2">
        <input type="hidden" name="action" value="send_email" />
        <input type="email" name="to_email" value={orc.cliente_email ?? ''} placeholder="email do cliente"
               class="flex-1 px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
        <button type="submit" class="px-4 py-2.5 rounded-lg text-sm font-semibold bg-red-700 hover:bg-red-800 text-white transition whitespace-nowrap">
          ✉️ Enviar email
        </button>
      </form>

      {orc.enviado_via && (
        <p class="text-xs text-gray-400 mt-2">Último envio via {orc.enviado_via}{orc.enviado_at ? ` em ${new Date(orc.enviado_at).toLocaleString('pt-PT')}` : ''}.</p>
      )}
    </div>

    <!-- AGENDAMENTO -->
    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 mb-4">
      <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wide mb-3">Agendamento</h2>
      {orc.chamado_id ? (
        <a href={`/chamados/${orc.chamado_id}`} class="inline-flex items-center gap-2 text-sm text-red-700 font-medium hover:underline">
          Ver chamado #{orc.chamado_id} →
        </a>
      ) : (
        <form method="POST" action={`/api/orcamentos-diretos/${orc.id}`} class="flex flex-col sm:flex-row gap-2 sm:items-end">
          <input type="hidden" name="action" value="criar_agendamento" />
          <div class="flex-1">
            <label class="block text-xs text-gray-500 mb-1">Data e hora da visita</label>
            <input type="datetime-local" name="horario_agendado" required
                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
          </div>
          <button type="submit" class="px-4 py-2.5 rounded-lg text-sm font-semibold bg-amber-600 hover:bg-amber-700 text-white transition whitespace-nowrap">
            📅 Criar agendamento
          </button>
        </form>
      )}
    </div>

    <!-- ESTADO + REMOVER -->
    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 mb-6 flex flex-wrap items-center gap-3 justify-between">
      <form method="POST" action={`/api/orcamentos-diretos/${orc.id}`} class="flex items-center gap-2">
        <input type="hidden" name="action" value="set_status" />
        <label class="text-sm text-gray-500">Estado</label>
        <select name="status" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none">
          {['rascunho', 'enviado', 'aprovado', 'rejeitado'].map(s => (
            <option value={s} selected={orc.status === s}>{statusInfo[s].label}</option>
          ))}
        </select>
        <button type="submit" class="px-3 py-2 rounded-lg text-sm font-medium border border-gray-300 text-gray-700 hover:bg-gray-50 transition">Guardar</button>
      </form>

      <form method="POST" action={`/api/orcamentos-diretos/${orc.id}`} data-confirm="Eliminar este orçamento? Esta ação é irreversível.">
        <input type="hidden" name="action" value="delete" />
        <button type="submit" class="px-3 py-2 rounded-lg text-sm font-semibold bg-red-50 hover:bg-red-100 text-red-600 transition">🗑 Remover</button>
      </form>
    </div>

    <!-- EDITAR -->
    {locked ? (
      <div class="bg-gray-50 border border-gray-200 text-gray-500 rounded-lg px-4 py-3 text-sm">
        Este orçamento está {st.label.toLowerCase()} e não pode ser editado. Altere o estado para "Rascunho" ou "Enviado" para o editar.
      </div>
    ) : (
      <div>
        <h2 class="text-lg font-bold text-gray-800 mb-3">Editar orçamento</h2>
        <OrcamentoForm action={`/api/orcamentos-diretos/${orc.id}`} actionName="update" submitLabel="Guardar Alterações" ivaRate={ivaRate} orc={orc} itens={itens} />
      </div>
    )}
  </div>
</Layout>
