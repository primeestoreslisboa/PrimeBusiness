---
import Layout from '../../layouts/Layout.astro';
import { getDb } from '../../lib/db';
import SlotPicker from '../../components/SlotPicker.astro';
import { num } from '../../lib/orcamentos';
import { getAgendamentoIntervaloHoras } from '../../lib/settings';

const user = Astro.locals.user;
const sql = getDb();
// Filtro por estado. Padrão = "ativos" (tudo exceto finalizado/rejeitado).
const statusFilter = Astro.url.searchParams.get('status') || 'ativos';
const estadosSingulares = ['rascunho', 'enviado', 'aprovado', 'finalizado', 'rejeitado'];
let orcamentos;
if (statusFilter === 'ativos') {
  orcamentos = await sql`
    SELECT id, numero, cliente_nome, cliente_email, cliente_telefone, total, status, enviado_via, chamado_id, created_at
    FROM orcamentos_diretos
    WHERE status NOT IN ('finalizado', 'rejeitado')
    ORDER BY created_at DESC
  `;
} else if (estadosSingulares.includes(statusFilter)) {
  orcamentos = await sql`
    SELECT id, numero, cliente_nome, cliente_email, cliente_telefone, total, status, enviado_via, chamado_id, created_at
    FROM orcamentos_diretos
    WHERE status = ${statusFilter}
    ORDER BY created_at DESC
  `;
} else {
  // 'todos' ou qualquer outro valor
  orcamentos = await sql`
    SELECT id, numero, cliente_nome, cliente_email, cliente_telefone, total, status, enviado_via, chamado_id, created_at
    FROM orcamentos_diretos
    ORDER BY created_at DESC
  `;
}
const chamadosAbertos = await sql`
  SELECT id, nome, cidade, horario_agendado
  FROM chamados
  WHERE status IN ('pendente', 'em_andamento')
  ORDER BY horario_agendado DESC
  LIMIT 100
`;
const intervaloHoras = await getAgendamentoIntervaloHoras(3);
const fmtChamado = (c: any) => {
  const dt = new Date(c.horario_agendado).toLocaleString('pt-PT', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Lisbon' });
  return `#${c.id} · ${c.nome}${c.cidade ? ` (${c.cidade})` : ''} · ${dt}`;
};
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
const errMsg = Astro.url.searchParams.get('msg');

const successMessages: Record<string, string> = {
  email_sent: 'Orçamento enviado por email (PDF anexado).',
  deleted: 'Orçamento removido.',
  created: 'Orçamento criado.',
  desassociado: 'Orçamento desassociado do agendamento.',
};
const errorMessages: Record<string, string> = {
  no_email: 'Indique um email de destino.',
  no_phone: 'Indique um telefone de destino.',
  no_horario: 'Indique a data e hora do agendamento.',
  agendamento_incompleto: 'Para agendar é preciso telefone, morada e localidade do cliente.',
  no_chamado: 'Escolha um agendamento válido para associar.',
  chamado_fechado: 'Esse agendamento já não está em aberto.',
  email_failed: `Falha ao enviar email${errMsg ? `: ${errMsg}` : '.'}`,
  locked: 'Orçamento fechado: não pode ser editado.',
  not_found: 'Orçamento não encontrado.',
  server: 'Ocorreu um erro no servidor.',
};

const statusInfo: Record<string, { label: string; cls: string }> = {
  rascunho: { label: 'Rascunho', cls: 'bg-gray-100 text-gray-600' },
  enviado: { label: 'Enviado', cls: 'bg-blue-100 text-blue-700' },
  aprovado: { label: 'Aprovado', cls: 'bg-green-100 text-green-700' },
  finalizado: { label: 'Finalizado', cls: 'bg-emerald-100 text-emerald-800' },
  rejeitado: { label: 'Rejeitado', cls: 'bg-red-100 text-red-700' },
};
const eur = (n: number) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
---
<Layout title="Orçamentos" user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Orçamentos</h1>
      <a href="/orcamentos/novo" class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">+ Novo</a>
    </div>

    <div class="flex gap-2 overflow-x-auto pb-1 mb-4">
      {[
        { v: 'ativos', label: 'Ativos' },
        { v: 'todos', label: 'Todos' },
        { v: 'rascunho', label: 'Rascunho' },
        { v: 'enviado', label: 'Enviado' },
        { v: 'aprovado', label: 'Aprovado' },
        { v: 'finalizado', label: 'Finalizado' },
        { v: 'rejeitado', label: 'Rejeitado' },
      ].map(f => (
        <a
          href={f.v === 'ativos' ? '/orcamentos' : `?status=${f.v}`}
          class={`flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition ${statusFilter === f.v ? 'bg-red-700 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}
        >{f.label}</a>
      ))}
    </div>

    {success && <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">✅ {successMessages[success] ?? 'Operação realizada com sucesso.'}</div>}
    {error && <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">❌ {errorMessages[error] ?? 'Ocorreu um erro a processar o pedido.'}</div>}

    {orcamentos.length === 0 && (
      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-8 text-center text-gray-500">
        <p class="mb-3">Ainda não há orçamentos.</p>
        <a href="/orcamentos/novo" class="text-red-700 font-medium hover:underline">Criar o primeiro orçamento →</a>
      </div>
    )}

    <div class="space-y-3">
      {orcamentos.map((o: any) => {
        const st = statusInfo[o.status] ?? statusInfo.rascunho;
        const apiUrl = `/api/orcamentos-diretos/${o.id}`;
        return (
          <div class="relative bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
            <a href={`/orcamentos/${o.id}/editar`} class="block p-4 pb-14">
              <div class="flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <p class="font-semibold text-gray-800 truncate">{o.cliente_nome}</p>
                    {o.chamado_id && <span class="text-[10px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded">Agendado</span>}
                  </div>
                  {o.cliente_telefone && <p class="text-xs text-gray-500 truncate">📞 {o.cliente_telefone}</p>}
                  {o.cliente_email && <p class="text-xs text-gray-500 truncate">✉️ {o.cliente_email}</p>}
                  <p class="text-xs text-gray-400 mt-0.5">{o.numero ?? `#${o.id}`}</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="font-semibold text-red-700">{eur(num(o.total))} €</p>
                  <span class={`inline-block text-[11px] px-2 py-0.5 rounded mt-1 ${st.cls}`}>{st.label}</span>
                </div>
              </div>
            </a>

            <!-- AÇÕES (flutuantes no canto inferior direito do card) -->
            <div class="absolute right-2 bottom-2 flex items-center gap-0.5">
              <a href={`/orcamentos/${o.id}/editar`} title="Editar"
                 class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </a>

              <button type="button" title="Enviar email"
                      data-open="modal-email" data-api={apiUrl} data-email={o.cliente_email ?? ''}
                      class="w-8 h-8 flex items-center justify-center rounded-lg text-red-600 hover:bg-red-50 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </button>

              <button type="button" title="Enviar WhatsApp"
                      data-open="modal-whatsapp" data-api={apiUrl} data-phone={o.cliente_telefone ?? ''}
                      class="w-8 h-8 flex items-center justify-center rounded-lg text-green-600 hover:bg-green-50 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.737-.98zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              </button>

              {o.chamado_id ? (
                <>
                  <a href={`/chamados/${o.chamado_id}`} title="Ver chamado"
                     class="w-8 h-8 flex items-center justify-center rounded-lg text-amber-600 hover:bg-amber-50 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </a>
                  <form method="POST" action={apiUrl} data-confirm="Desassociar este orçamento do agendamento?">
                    <input type="hidden" name="action" value="desassociar_agendamento" />
                    <button type="submit" title="Desassociar do agendamento"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5m-1.328-4.328a4 4 0 005.656 0l3-3a4 4 0 10-5.656-5.656l-1.5 1.5M4 4l16 16"/></svg>
                    </button>
                  </form>
                </>
              ) : (
                <button type="button" title="Criar agendamento"
                        data-open="modal-agendamento" data-api={apiUrl}
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-amber-600 hover:bg-amber-50 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </button>
              )}

              <a href={`/api/orcamentos-diretos/${o.id}/pdf`} target="_blank" rel="noopener" title="Ver / Descarregar PDF"
                 class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-700 hover:bg-gray-100 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </a>

              <form method="POST" action={apiUrl} data-confirm="Eliminar este orçamento? Esta ação é irreversível.">
                <input type="hidden" name="action" value="delete" />
                <button type="submit" title="Remover"
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-red-500 hover:bg-red-50 hover:text-red-700 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-6 0h6"/></svg>
                </button>
              </form>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- ============ MODAIS PARTILHADOS ============ -->
  <!-- Email -->
  <div data-modal="modal-email" class="fixed inset-0 z-[90] hidden" aria-hidden="true">
    <div class="modal-backdrop absolute inset-0 bg-black/40"></div>
    <div class="absolute inset-0 flex items-end sm:items-center sm:justify-center p-0 sm:p-4">
      <div class="w-full sm:max-w-md bg-white rounded-t-2xl sm:rounded-2xl shadow-xl border border-gray-200 p-5">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-base font-semibold text-gray-800">Enviar por email</h3>
          <button type="button" class="modal-close w-8 h-8 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100">✕</button>
        </div>
        <form method="POST" data-form="email" class="space-y-3">
          <input type="hidden" name="action" value="send_email" />
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email do cliente</label>
            <input type="text" name="to_email" required inputmode="email"
                   placeholder="cliente@email.com; outro@email.com"
                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
            <p class="text-xs text-gray-400 mt-1">Pode enviar para vários destinatários, separados por ponto e vírgula (;).</p>
            <p class="text-xs text-gray-400">Vai ser gerado o PDF do orçamento e anexado ao email.</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Comentário (opcional)</label>
            <textarea name="mensagem" rows="4" placeholder="Mensagem a incluir no corpo do email…"
                      class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none resize-none"></textarea>
            <p class="text-xs text-gray-400 mt-1">Este texto é adicionado ao corpo do email enviado ao cliente.</p>
          </div>
          <div class="grid grid-cols-2 gap-2 pt-1">
            <button type="button" class="modal-close py-2.5 rounded-lg text-sm font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50">Cancelar</button>
            <button type="submit" class="py-2.5 rounded-lg text-sm font-semibold bg-red-700 hover:bg-red-800 text-white">Enviar email</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- WhatsApp -->
  <div data-modal="modal-whatsapp" class="fixed inset-0 z-[90] hidden" aria-hidden="true">
    <div class="modal-backdrop absolute inset-0 bg-black/40"></div>
    <div class="absolute inset-0 flex items-end sm:items-center sm:justify-center p-0 sm:p-4">
      <div class="w-full sm:max-w-md bg-white rounded-t-2xl sm:rounded-2xl shadow-xl border border-gray-200 p-5">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-base font-semibold text-gray-800">Enviar por WhatsApp</h3>
          <button type="button" class="modal-close w-8 h-8 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100">✕</button>
        </div>
        <form method="POST" data-form="whatsapp" target="_blank" class="space-y-3">
          <input type="hidden" name="action" value="send_whatsapp" />
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Telefone do cliente</label>
            <input type="tel" name="to_phone" required
                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
            <p class="text-xs text-gray-400 mt-1">Abre o WhatsApp com a mensagem e o link do orçamento (PDF descarregável).</p>
          </div>
          <div class="grid grid-cols-2 gap-2 pt-1">
            <button type="button" class="modal-close py-2.5 rounded-lg text-sm font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50">Cancelar</button>
            <button type="submit" class="py-2.5 rounded-lg text-sm font-semibold bg-green-600 hover:bg-green-700 text-white">Abrir WhatsApp</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Agendamento -->
  <div data-modal="modal-agendamento" class="fixed inset-0 z-[90] hidden" aria-hidden="true">
    <div class="modal-backdrop absolute inset-0 bg-black/40"></div>
    <div class="absolute inset-0 flex items-end sm:items-center sm:justify-center p-0 sm:p-4">
      <div class="w-full sm:max-w-md bg-white rounded-t-2xl sm:rounded-2xl shadow-xl border border-gray-200 p-5">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-base font-semibold text-gray-800">Criar agendamento</h3>
          <button type="button" class="modal-close w-8 h-8 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100">✕</button>
        </div>
        <form method="POST" data-form="agendamento" class="space-y-3">
          <input type="hidden" name="action" value="criar_agendamento" data-action-input />
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Associar a agendamento existente</label>
            <select name="chamado_id" data-chamado-select
                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none bg-white">
              <option value="">— Criar novo agendamento —</option>
              {chamadosAbertos.map((c: any) => <option value={c.id}>{fmtChamado(c)}</option>)}
            </select>
            <p class="text-xs text-gray-400 mt-1">Escolha um chamado em aberto, ou deixe em "Criar novo" para gerar um novo.</p>
          </div>
          <div data-novo-agendamento>
            <label class="block text-sm font-medium text-gray-700 mb-1">Data e hora da visita</label>
            <SlotPicker name="horario_agendado" intervaloHoras={intervaloHoras} minToday={true} />
            <p class="text-xs text-gray-400 mt-1">Gera um chamado com os dados do cliente. Necessário telefone, morada e localidade. O cliente é atendido numa janela de {intervaloHoras} horas a partir da hora escolhida.</p>
          </div>
          <div class="grid grid-cols-2 gap-2 pt-1">
            <button type="button" class="modal-close py-2.5 rounded-lg text-sm font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50">Cancelar</button>
            <button type="submit" class="py-2.5 rounded-lg text-sm font-semibold bg-amber-600 hover:bg-amber-700 text-white" data-agendar-submit>Criar agendamento</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function closeAllModals() {
      document.querySelectorAll('[data-modal]').forEach(m => {
        m.classList.add('hidden');
        m.setAttribute('aria-hidden', 'true');
      });
      document.body.style.overflow = '';
    }
    document.querySelectorAll('[data-open]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-open')!;
        const api = btn.getAttribute('data-api') || '';
        const modal = document.querySelector(`[data-modal="${id}"]`);
        if (!modal) return;
        const form = modal.querySelector('form') as HTMLFormElement | null;
        if (form) {
          form.action = api;
          const emailInput = form.querySelector('input[name="to_email"]') as HTMLInputElement | null;
          if (emailInput) emailInput.value = btn.getAttribute('data-email') || '';
          const phoneInput = form.querySelector('input[name="to_phone"]') as HTMLInputElement | null;
          if (phoneInput) phoneInput.value = btn.getAttribute('data-phone') || '';
        }
        modal.classList.remove('hidden');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        (modal.querySelector('input, select, textarea') as HTMLElement | null)?.focus();
      });
    });
    document.querySelectorAll('.modal-close, .modal-backdrop').forEach(el => {
      el.addEventListener('click', closeAllModals);
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAllModals(); });

    // Agendamento: alternar entre criar novo e associar a um existente
    const agSelect = document.querySelector('[data-chamado-select]') as HTMLSelectElement | null;
    const agActionInput = document.querySelector('[data-action-input]') as HTMLInputElement | null;
    const agNovoBlock = document.querySelector('[data-novo-agendamento]') as HTMLElement | null;
    const agSubmit = document.querySelector('[data-agendar-submit]') as HTMLElement | null;
    const agSlotFields = agNovoBlock ? agNovoBlock.querySelectorAll('.sp-date, .sp-slot') : [];
    function syncAgendar() {
      const existing = !!(agSelect && agSelect.value);
      if (agActionInput) agActionInput.value = existing ? 'associar_agendamento' : 'criar_agendamento';
      if (agNovoBlock) agNovoBlock.style.display = existing ? 'none' : '';
      agSlotFields.forEach(el => { (el as HTMLInputElement | HTMLSelectElement).required = !existing; });
      if (agSubmit) agSubmit.textContent = existing ? 'Associar agendamento' : 'Criar agendamento';
    }
    agSelect?.addEventListener('change', syncAgendar);
    syncAgendar();
  </script>
</Layout>
