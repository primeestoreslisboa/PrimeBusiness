---
import Layout from '../../layouts/Layout.astro';
import { getDb } from '../../lib/db';
import { num } from '../../lib/orcamentos';

const user = Astro.locals.user;
const sql = getDb();
const orcamentos = await sql`
  SELECT id, numero, cliente_nome, total, status, enviado_via, chamado_id, created_at
  FROM orcamentos_diretos
  ORDER BY created_at DESC
`;
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');

const statusInfo: Record<string, { label: string; cls: string }> = {
  rascunho: { label: 'Rascunho', cls: 'bg-gray-100 text-gray-600' },
  enviado: { label: 'Enviado', cls: 'bg-blue-100 text-blue-700' },
  aprovado: { label: 'Aprovado', cls: 'bg-green-100 text-green-700' },
  rejeitado: { label: 'Rejeitado', cls: 'bg-red-100 text-red-700' },
};
const eur = (n: number) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
---
<Layout title="Orçamentos" user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Orçamentos</h1>
      <a href="/orcamentos/novo" class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">+ Novo</a>
    </div>

    {success && <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">✅ Operação realizada com sucesso.</div>}
    {error && <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">❌ Ocorreu um erro a processar o pedido.</div>}

    {orcamentos.length === 0 && (
      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-8 text-center text-gray-500">
        <p class="mb-3">Ainda não há orçamentos.</p>
        <a href="/orcamentos/novo" class="text-red-700 font-medium hover:underline">Criar o primeiro orçamento →</a>
      </div>
    )}

    <div class="space-y-2">
      {orcamentos.map((o: any) => {
        const st = statusInfo[o.status] ?? statusInfo.rascunho;
        return (
          <a href={`/orcamentos/${o.id}`} class="block bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
            <div class="flex items-center justify-between px-4 py-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <p class="font-semibold text-gray-800 truncate">{o.cliente_nome}</p>
                  {o.chamado_id && <span class="text-[10px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded">Agendado</span>}
                </div>
                <p class="text-xs text-gray-400">{o.numero ?? `#${o.id}`}</p>
              </div>
              <div class="text-right flex-shrink-0 ml-3">
                <p class="font-semibold text-red-700">{eur(num(o.total))} €</p>
                <span class={`inline-block text-[11px] px-2 py-0.5 rounded mt-1 ${st.cls}`}>{st.label}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
