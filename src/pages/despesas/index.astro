---
import Layout from '../../layouts/Layout.astro';
import { getDb } from '../../lib/db';
import { num } from '../../lib/orcamentos';
import { CATEGORIAS_DESPESA } from '../../lib/despesas';

const user = Astro.locals.user;
if (user?.role !== 'admin') return Astro.redirect('/dashboard');

const sql = getDb();

const now = new Date();
const pad = (n: number) => String(n).padStart(2, '0');
const firstOfMonth = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-01`;
const lastOfMonthDate = new Date(now.getFullYear(), now.getMonth() + 1, 0);
const lastOfMonth = `${lastOfMonthDate.getFullYear()}-${pad(lastOfMonthDate.getMonth() + 1)}-${pad(lastOfMonthDate.getDate())}`;
const hoje = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

const isDate = (v: string | null) => !!v && /^\d{4}-\d{2}-\d{2}$/.test(v);
const de = isDate(Astro.url.searchParams.get('de')) ? Astro.url.searchParams.get('de')! : firstOfMonth;
const ate = isDate(Astro.url.searchParams.get('ate')) ? Astro.url.searchParams.get('ate')! : lastOfMonth;

const despesas = await sql`
  SELECT * FROM despesas
  WHERE data_despesa >= ${de}::date AND data_despesa <= ${ate}::date
  ORDER BY data_despesa DESC, id DESC
`;
const totalPeriodo = despesas.reduce((a: number, d: any) => a + num(d.valor), 0);

const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
const successMessages: Record<string, string> = {
  created: 'Despesa registada.',
  updated: 'Despesa atualizada.',
  deleted: 'Despesa removida.',
};
const errorMessages: Record<string, string> = {
  validation: 'Preencha descrição, data e um valor válido.',
  server: 'Ocorreu um erro no servidor.',
};

const eur = (n: number) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const fmtData = (v: any) => new Date(v).toLocaleDateString('pt-PT', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Europe/Lisbon' });
const toInput = (v: any) => { const d = new Date(v); return Number.isNaN(d.getTime()) ? String(v).slice(0, 10) : d.toISOString().slice(0, 10); };
const inputCls = 'w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none';
---
<Layout title="Despesas" user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Despesas Gerais</h1>
    </div>

    {success && <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">✅ {successMessages[success] ?? 'Operação realizada.'}</div>}
    {error && <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">❌ {errorMessages[error] ?? 'Ocorreu um erro.'}</div>}

    <!-- NOVA DESPESA -->
    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 mb-4">
      <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wide mb-3">Nova Despesa</h2>
      <form method="POST" action="/api/despesas" class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Data *</label>
            <input type="date" name="data_despesa" required value={hoje} class={inputCls} />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Valor (€) *</label>
            <input type="number" name="valor" required step="0.01" min="0" placeholder="0,00" class={`${inputCls} text-right`} />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Descrição *</label>
          <input type="text" name="descricao" required placeholder="Ex.: Compra de tecido para stock" class={inputCls} />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Nº da fatura</label>
            <input type="text" name="numero_fatura" class={inputCls} />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Fornecedor</label>
            <input type="text" name="fornecedor" class={inputCls} />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Categoria</label>
          <select name="categoria" class={inputCls}>
            {CATEGORIAS_DESPESA.map(c => <option value={c}>{c}</option>)}
          </select>
        </div>
        <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 rounded-lg transition">+ Registar Despesa</button>
      </form>
    </div>

    <!-- FILTRO PERÍODO -->
    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 mb-4">
      <div class="flex flex-wrap gap-2 mb-3">
        <a href="/despesas" class={`px-3 py-1.5 rounded-full text-xs font-medium transition ${(de === firstOfMonth && ate === lastOfMonth) ? 'bg-red-700 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}>Mês atual</a>
      </div>
      <form method="GET" class="flex flex-wrap items-end gap-3">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">De</label>
          <input type="date" name="de" value={de} class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Até</label>
          <input type="date" name="ate" value={ate} class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
        </div>
        <button type="submit" class="bg-red-700 hover:bg-red-800 text-white text-sm font-medium px-4 py-2 rounded-lg transition">Filtrar</button>
        <div class="ml-auto text-right">
          <p class="text-xs text-gray-500 uppercase">Total do período</p>
          <p class="text-lg font-bold text-gray-800">{eur(totalPeriodo)} €</p>
        </div>
      </form>
    </div>

    <!-- LISTA -->
    {despesas.length === 0 ? (
      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-8 text-center text-gray-500 text-sm">Sem despesas neste período.</div>
    ) : (
      <div class="space-y-2">
        {despesas.map((d: any) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100">
            <div class="flex items-start justify-between gap-3 p-4">
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-800">{d.descricao}</p>
                <p class="text-xs text-gray-500 mt-0.5">
                  {fmtData(d.data_despesa)}
                  <span class="mx-1">·</span>
                  <span class="inline-block px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">{d.categoria}</span>
                  {d.fornecedor && <span class="ml-1">· {d.fornecedor}</span>}
                  {d.numero_fatura && <span class="ml-1">· Fatura {d.numero_fatura}</span>}
                </p>
              </div>
              <div class="text-right flex-shrink-0">
                <p class="font-bold text-gray-800">{eur(num(d.valor))} €</p>
                <div class="flex gap-2 justify-end mt-1">
                  <button type="button" class="edit-toggle text-xs text-red-700 hover:underline" data-id={d.id}>Editar</button>
                  <form method="POST" action={`/api/despesas/${d.id}`} data-confirm="Remover esta despesa?" class="inline">
                    <input type="hidden" name="action" value="delete" />
                    <button type="submit" class="text-xs text-gray-400 hover:text-red-600">Remover</button>
                  </form>
                </div>
              </div>
            </div>
            <div id={`edit-${d.id}`} class="hidden border-t border-gray-100 p-4 bg-gray-50">
              <form method="POST" action={`/api/despesas/${d.id}`} class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Data *</label>
                    <input type="date" name="data_despesa" required value={toInput(d.data_despesa)} class={inputCls} />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Valor (€) *</label>
                    <input type="number" name="valor" required step="0.01" min="0" value={num(d.valor)} class={`${inputCls} text-right`} />
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 mb-1">Descrição *</label>
                  <input type="text" name="descricao" required value={d.descricao} class={inputCls} />
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Nº da fatura</label>
                    <input type="text" name="numero_fatura" value={d.numero_fatura ?? ''} class={inputCls} />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Fornecedor</label>
                    <input type="text" name="fornecedor" value={d.fornecedor ?? ''} class={inputCls} />
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 mb-1">Categoria</label>
                  <select name="categoria" class={inputCls}>
                    {CATEGORIAS_DESPESA.map(c => <option value={c} selected={d.categoria === c}>{c}</option>)}
                  </select>
                </div>
                <button type="submit" class="w-full bg-red-700 hover:bg-red-800 text-white font-semibold py-2.5 rounded-lg transition">Guardar Alterações</button>
              </form>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <script>
    document.querySelectorAll('.edit-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        document.getElementById(`edit-${id}`)?.classList.toggle('hidden');
      });
    });
  </script>
</Layout>
