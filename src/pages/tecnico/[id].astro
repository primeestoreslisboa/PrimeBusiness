---
import Layout from '../../layouts/Layout.astro';
import { randomUUID } from 'node:crypto';
import { getDb } from '../../lib/db';
import { getIvaRate } from '../../lib/settings';

const user = Astro.locals.user;
const { id } = Astro.params;
const sql = getDb();

const [chamado] = await sql`SELECT * FROM chamados WHERE id = ${id}`;
if (!chamado) return Astro.redirect('/chamados');

const servicos = await sql`SELECT * FROM servicos WHERE ativo = true ORDER BY nome`;
const orcamentos = await sql`SELECT id, total, include_iva, iva_rate, status, created_at FROM orcamentos WHERE chamado_id = ${id} ORDER BY created_at DESC`;
const createNew = Astro.url.searchParams.get('new') === '1';

if (createNew) {
  const initialIvaRate = await getIvaRate(23);
  const [newOrc] = await sql`
    INSERT INTO orcamentos (chamado_id, total, include_iva, iva_rate, status, aceite_token)
    VALUES (${id}, 0, false, ${initialIvaRate}, 'pendente', ${randomUUID()})
    RETURNING id
  `;
  return Astro.redirect(`/tecnico/${id}?orc=${newOrc.id}&success=orc_created`);
}

const orcParam = Astro.url.searchParams.get('orc');
const selectedOrc = (orcParam
  ? orcamentos.find((o: any) => String(o.id) === String(orcParam))
  : null) || null;
const selectedOrcId = selectedOrc ? String(selectedOrc.id) : '';
const selectedOrcConcluido = selectedOrc?.status === 'concluido' || selectedOrc?.status === 'rejeitado';
const orcStatusLabel: Record<string, string> = {
  pendente: 'Pendente',
  enviado: 'Enviado',
  aprovado: 'Aprovado',
  concluido: 'Rejeitado',
  rejeitado: 'Rejeitado',
};

const servicosSelecionados = await sql`
  SELECT cs.*, s.nome, s.unidade
  FROM chamado_servicos cs
  JOIN servicos s ON s.id = cs.servico_id
  WHERE cs.chamado_id = ${id} AND cs.orcamento_id = ${selectedOrcId || -1}
`;

const total = servicosSelecionados.reduce((acc: number, s: any) => acc + s.quantidade * parseFloat(s.preco_unitario), 0);
const currentIvaRate = await getIvaRate(23);
const includeIva = !!selectedOrc?.include_iva;
const storedIvaRate = Number.parseFloat(String(selectedOrc?.iva_rate ?? ''));
const ivaRate = includeIva
  ? (Number.isFinite(storedIvaRate) && storedIvaRate > 0 ? Math.min(100, Math.max(0, storedIvaRate)) : currentIvaRate)
  : currentIvaRate;
const ivaValue = includeIva ? total * (ivaRate / 100) : 0;
const totalFinal = total + ivaValue;

const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
---
<Layout title={`Tecnico - Chamado #${id}`} user={user}>
  <div class="py-6" id="orcamento-page-meta" data-base-total={total.toFixed(2)} data-iva-rate={ivaRate.toFixed(2)} data-chamado-id={id} data-orc-id={selectedOrcId}>
    <div class="flex items-center gap-3 mb-4">
      <a href={`/chamados/${id}`} class="text-gray-400 hover:text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div>
        <h1 class="text-xl font-bold text-gray-800">Pagina do Tecnico</h1>
        <p class="text-sm text-gray-500">Chamado #{id} - {chamado.nome}</p>
      </div>
    </div>

    {success === 'orcamento' && (
      <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Orcamento guardado com sucesso.
      </div>
    )}
    {success === 'email_sent' && (
      <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Orcamento enviado por email com sucesso.
      </div>
    )}
    {success === 'orc_created' && (
      <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Novo orcamento criado.
      </div>
    )}
    {error === 'email_failed' && (
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Falha ao enviar email.{Astro.url.searchParams.get('msg') ? ` Erro: ${decodeURIComponent(Astro.url.searchParams.get('msg')!)}` : ''}
      </div>
    )}
    {error === 'no_email' && (
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Este cliente nao tem email registado.
      </div>
    )}
    {error === 'no_services' && (
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Adicione pelo menos um servico antes de guardar.
      </div>
    )}
    {error === 'no_phone' && (
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Este cliente nao tem telefone registado.
      </div>
    )}
    {error === 'no_orcamento' && (
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Crie um novo orcamento para poder guardar ou enviar.
      </div>
    )}
    {error === 'orc_locked' && (
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 rounded-lg px-4 py-3 mb-4 text-sm">
        Este orcamento esta concluido e nao pode ser editado.
      </div>
    )}

    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 mb-4">
      {selectedOrc ? (
        <p class="text-sm text-gray-600">Orcamento #{selectedOrc.id} - {orcStatusLabel[selectedOrc.status] || selectedOrc.status} {selectedOrc.include_iva ? `| Com IVA (${ivaRate.toFixed(2)}%)` : '| Sem IVA'}</p>
      ) : (
        <p class="text-sm text-gray-500">Selecione um orcamento para editar no detalhe do chamado.</p>
      )}
    </div>

    <div class="bg-red-50 border border-red-100 rounded-xl p-4 mb-4">
      <p class="text-sm font-medium text-red-900">{chamado.nome}</p>
      <p class="text-xs text-red-700">{chamado.morada}, {chamado.cidade}</p>
      <p class="text-xs text-red-700">{chamado.descricao}</p>
    </div>

    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 mb-4">
      <h2 class="font-semibold text-gray-700 mb-3 text-sm uppercase tracking-wide">Adicionar Servico</h2>
      <form method="POST" action={`/api/orcamento/${id}`} class="space-y-3">
        <input type="hidden" name="action" value="add_service" />
        <input type="hidden" name="orc_id" value={selectedOrcId} />
        <input type="hidden" name="include_iva" value={includeIva ? '1' : '0'} class="include-iva-hidden" />
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Servico</label>
          <select
            name="servico_id"
            required
            id="servico-select"
            onchange="const o=this.selectedOptions&&this.selectedOptions[0]; const raw=((o&&o.dataset&&o.dataset.preco)||'').toString().replace(',', '.'); const p=document.getElementById('preco-input'); if(p&&raw){p.value=raw; p.dispatchEvent(new Event('input',{bubbles:true}));}"
            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none bg-white"
          >
            <option value="">Selecionar servico...</option>
            {servicos.map((s: any) => (
              <option value={s.id} data-preco={parseFloat(s.preco).toFixed(2)} data-unidade={s.unidade}>
                {s.nome} - EUR {parseFloat(s.preco).toFixed(2)}/{s.unidade}
              </option>
            ))}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Quantidade</label>
            <input type="number" name="quantidade" min="1" value="1" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Preco Unit. (EUR)</label>
            <input type="number" name="preco_unitario" step="0.01" min="0" required id="preco-input" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Observacao</label>
          <input type="text" name="observacao" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
        </div>
        <div id="subtotal-preview" class="hidden bg-red-50 border border-red-100 rounded-lg px-3 py-2 flex items-center justify-between">
          <span class="text-sm text-red-800 font-medium">Subtotal deste item:</span>
          <span id="subtotal-value" class="font-bold text-red-800 text-lg">EUR 0.00</span>
        </div>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <input
            id="include-iva-toggle"
            type="checkbox"
            checked={includeIva}
            disabled={!selectedOrcId || selectedOrcConcluido}
            class="h-4 w-4 accent-green-600 disabled:opacity-50"
          />
          <span>Incluir IVA ({ivaRate.toFixed(2)}%) no orcamento final</span>
        </label>
        <button type="submit" disabled={!selectedOrcId || selectedOrcConcluido} class={`w-full font-semibold py-2.5 rounded-lg transition text-sm ${selectedOrcId && !selectedOrcConcluido ? 'bg-green-600 hover:bg-green-700 text-white' : 'bg-gray-100 text-gray-400 cursor-not-allowed'}`}>
          + Adicionar Servico
        </button>
      </form>
    </div>

    {servicosSelecionados.length > 0 && (
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-4">
        <div class="px-4 py-3 border-b border-gray-100">
          <h2 class="font-semibold text-gray-700 text-sm uppercase tracking-wide">Servicos Realizados</h2>
        </div>
        <div class="divide-y divide-gray-50">
          {servicosSelecionados.map((s: any) => (
            <div class="flex items-center justify-between px-4 py-3">
              <div class="flex-1">
                <p class="text-sm font-medium text-gray-800">{s.nome}</p>
                <p class="text-xs text-gray-500">{s.quantidade} x EUR {parseFloat(s.preco_unitario).toFixed(2)}</p>
                {s.observacao && <p class="text-xs text-gray-400 italic">{s.observacao}</p>}
              </div>
              <div class="flex items-center gap-3">
                <p class="font-semibold text-gray-800">EUR {(s.quantidade * parseFloat(s.preco_unitario)).toFixed(2)}</p>
                <form method="POST" action={`/api/orcamento/${id}`}>
                  <input type="hidden" name="action" value="remove_service" />
                  <input type="hidden" name="orc_id" value={selectedOrcId} />
                  <input type="hidden" name="chamado_servico_id" value={s.id} />
                  <button type="submit" disabled={!selectedOrcId || selectedOrcConcluido} class={`w-8 h-8 flex items-center justify-center rounded-lg transition ${selectedOrcId && !selectedOrcConcluido ? 'bg-red-50 hover:bg-red-100 text-red-500 hover:text-red-700' : 'bg-gray-50 text-gray-300 cursor-not-allowed'}`} title="Eliminar">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-6 0h6" />
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          ))}
        </div>
        <div class="px-4 py-3 bg-gray-50 rounded-b-xl flex items-center justify-between">
          <div class="text-sm">
            <p class="font-bold text-gray-700">Subtotal: EUR <span id="orc-subtotal-value">{total.toFixed(2)}</span></p>
            <p class="text-gray-500">IVA ({ivaRate.toFixed(2)}%): EUR <span id="orc-iva-value">{ivaValue.toFixed(2)}</span></p>
            <p class="font-bold text-gray-800">Total final: EUR <span id="orc-total-final-value">{totalFinal.toFixed(2)}</span></p>
          </div>
        </div>
      </div>
    )}

    {servicosSelecionados.length > 0 && (
      <div class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <form method="POST" action={`/api/orcamento/${id}`}>
            <input type="hidden" name="action" value="send_email" />
            <input type="hidden" name="orc_id" value={selectedOrcId} />
            <input type="hidden" name="include_iva" value={includeIva ? '1' : '0'} class="include-iva-hidden" />
            <button type="submit" disabled={!chamado.email || !selectedOrcId || selectedOrcConcluido}
              class={`w-full py-3 rounded-xl font-semibold text-sm transition ${chamado.email && selectedOrcId && !selectedOrcConcluido ? 'bg-red-700 hover:bg-red-800 text-white' : 'bg-gray-100 text-gray-400 cursor-not-allowed'}`}>
              Enviar por Email
            </button>
          </form>

          <form method="POST" action={`/api/orcamento/${id}`}>
            <input type="hidden" name="action" value="send_whatsapp" />
            <input type="hidden" name="orc_id" value={selectedOrcId} />
            <input type="hidden" name="include_iva" value={includeIva ? '1' : '0'} class="include-iva-hidden" />
            <button type="submit" disabled={!chamado.telefone || !selectedOrcId || selectedOrcConcluido}
              class={`w-full py-3 rounded-xl font-semibold text-sm transition ${chamado.telefone && selectedOrcId && !selectedOrcConcluido ? 'bg-green-500 hover:bg-green-600 text-white' : 'bg-gray-100 text-gray-400 cursor-not-allowed'}`}>
              WhatsApp
            </button>
          </form>
        </div>

        <form method="POST" action={`/api/orcamento/${id}`}>
          <input type="hidden" name="action" value="save_orcamento" />
          <input type="hidden" name="orc_id" value={selectedOrcId} />
          <input type="hidden" name="include_iva" value={includeIva ? '1' : '0'} class="include-iva-hidden" />
          <button type="submit" disabled={!selectedOrcId || selectedOrcConcluido} class={`w-full font-semibold py-3 rounded-xl transition ${selectedOrcId && !selectedOrcConcluido ? 'bg-green-600 hover:bg-green-700 text-white' : 'bg-gray-100 text-gray-400 cursor-not-allowed'}`}>
            Guardar Orcamento
          </button>
        </form>
      </div>
    )}
  </div>
</Layout>

<script>
  function initOrcamentoUi() {
    const pageMeta = document.getElementById('orcamento-page-meta');
    const select = document.getElementById('servico-select');
    const precoInput = document.getElementById('preco-input');
    const qtdInput = document.querySelector('input[name="quantidade"]');
    const preview = document.getElementById('subtotal-preview');
    const previewVal = document.getElementById('subtotal-value');
    const includeIvaToggle = document.getElementById('include-iva-toggle');
    const subtotalValue = document.getElementById('orc-subtotal-value');
    const ivaValue = document.getElementById('orc-iva-value');
    const totalFinalValue = document.getElementById('orc-total-final-value');
    const includeIvaHiddenInputs = document.querySelectorAll('.include-iva-hidden');
    const baseTotal = Number.parseFloat(pageMeta?.dataset.baseTotal || '0') || 0;
    const ivaRate = Number.parseFloat(pageMeta?.dataset.ivaRate || '0') || 0;
    const chamadoId = pageMeta?.dataset.chamadoId || '';
    const orcId = pageMeta?.dataset.orcId || '';

    function calc() {
      const preco = Number.parseFloat((precoInput?.value || '0').replace(',', '.')) || 0;
      const qtd = Number.parseInt(qtdInput?.value || '1', 10) || 0;
      if (preco > 0 && qtd > 0 && previewVal && preview) {
        previewVal.textContent = `EUR ${(preco * qtd).toFixed(2)}`;
        preview.classList.remove('hidden');
      } else if (preview) {
        preview.classList.add('hidden');
      }
    }

    function fillPrecoFromServico() {
      if (!select || !precoInput || !select.selectedOptions?.length) return;
      const opt = select.selectedOptions[0];
      const precoRaw = (opt?.dataset?.preco || '').toString().replace(',', '.').trim();
      if (!precoRaw) return;
      precoInput.value = precoRaw;
      calc();
    }

    if (select) {
      select.addEventListener('change', fillPrecoFromServico);
      select.addEventListener('input', fillPrecoFromServico);
    }

    if (precoInput) {
      precoInput.addEventListener('input', calc);
    }

    if (qtdInput) {
      qtdInput.addEventListener('input', calc);
    }

    function syncIvaState() {
      const includeIva = !!includeIvaToggle?.checked;
      includeIvaHiddenInputs.forEach((input) => {
        input.value = includeIva ? '1' : '0';
      });
      if (!subtotalValue || !ivaValue || !totalFinalValue) return;
      const iva = includeIva ? baseTotal * (ivaRate / 100) : 0;
      const finalTotal = baseTotal + iva;
      subtotalValue.textContent = baseTotal.toFixed(2);
      ivaValue.textContent = iva.toFixed(2);
      totalFinalValue.textContent = finalTotal.toFixed(2);
    }

    async function persistIvaState() {
      if (!chamadoId || !orcId || !includeIvaToggle) return;
      const fd = new FormData();
      fd.set('action', 'update_iva');
      fd.set('orc_id', String(orcId));
      fd.set('include_iva', includeIvaToggle.checked ? '1' : '0');
      try {
        await fetch(`/api/orcamento/${encodeURIComponent(chamadoId)}`, {
          method: 'POST',
          body: fd,
          credentials: 'same-origin',
        });
      } catch {
        // Ignore transient errors. State remains reflected in UI and next save/send persists it.
      }
    }

    if (includeIvaToggle) {
      includeIvaToggle.addEventListener('change', () => {
        syncIvaState();
        persistIvaState();
      });
    }
    fillPrecoFromServico();
    syncIvaState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOrcamentoUi, { once: true });
  } else {
    initOrcamentoUi();
  }
</script>

<script define:vars={{ cleanupEnabled: success === 'orc_created' && !!selectedOrcId && servicosSelecionados.length === 0, cleanupOrcId: selectedOrcId || '', chamadoId: id }}>
  if (cleanupEnabled && cleanupOrcId) {
    let skipCleanup = false;
    document.querySelectorAll('form').forEach((f) => {
      f.addEventListener('submit', () => {
        skipCleanup = true;
      });
    });

    const runCleanup = () => {
      if (skipCleanup) return;
      skipCleanup = true;

      const fd = new FormData();
      fd.set('action', 'cleanup_empty_orcamento');
      fd.set('orc_id', String(cleanupOrcId));

      if (navigator.sendBeacon) {
        navigator.sendBeacon(`/api/orcamento/${chamadoId}`, fd);
      } else {
        fetch(`/api/orcamento/${chamadoId}`, {
          method: 'POST',
          body: fd,
          keepalive: true,
        });
      }
    };

    window.addEventListener('pagehide', runCleanup);
    window.addEventListener('beforeunload', runCleanup);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') runCleanup();
    });
  }
</script>
