---
import Layout from '../../layouts/Layout.astro';
import SlotPicker from '../../components/SlotPicker.astro';
import { getDb } from '../../lib/db';
import { getAgendamentoIntervaloHoras } from '../../lib/settings';

const user = Astro.locals.user;
const sql = getDb();
const intervaloHoras = await getAgendamentoIntervaloHoras(3);

const tecnicos = await sql`SELECT id, name FROM users WHERE deleted_at IS NULL ORDER BY name`;

const error = Astro.url.searchParams.get('error');
const prefillNome = Astro.url.searchParams.get('nome') || '';
const prefillTelefone = Astro.url.searchParams.get('telefone') || '';
const prefillEmail = Astro.url.searchParams.get('email') || '';
const prefillCodigoPostal = Astro.url.searchParams.get('codigo_postal') || '';
const prefillMorada = Astro.url.searchParams.get('morada') || '';
const prefillBairro = Astro.url.searchParams.get('bairro') || '';
const prefillCidade = Astro.url.searchParams.get('cidade') || '';
---
<Layout title="Novo Chamado" user={user}>
  <div class="py-6">
    <div class="flex items-center gap-3 mb-6">
      <a href="/chamados" class="text-gray-400 hover:text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <h1 class="text-2xl font-bold text-gray-800">Novo Chamado</h1>
    </div>

    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">
        {error === 'slot_conflict'
          ? `Horario comprometido: ja existe outro agendamento que ocupa a janela de ${intervaloHoras} horas.`
          : 'Erro ao criar chamado. Verifique os dados e tente novamente.'}
      </div>
    )}

    <form method="POST" action="/api/chamados" class="space-y-4" id="novo-chamado-form">
      <input type="hidden" name="allow_conflict" value="0" id="novo-allow-conflict" />
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <h2 class="font-semibold text-gray-700 mb-3 text-sm uppercase tracking-wide">Dados do Cliente</h2>
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nome *</label>
            <input type="text" name="nome" value={prefillNome} required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Telefone *</label>
              <input type="tel" name="telefone" value={prefillTelefone} required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
              <input type="email" name="email" value={prefillEmail} class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <h2 class="font-semibold text-gray-700 mb-3 text-sm uppercase tracking-wide">Morada</h2>
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Codigo Postal</label>
            <input id="codigo-postal-input" type="text" name="codigo_postal" value={prefillCodigoPostal} placeholder="0000-000" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Morada *</label>
            <input id="morada-input" type="text" name="morada" value={prefillMorada} required placeholder="Rua, numero, andar..." class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Bairro</label>
              <input id="bairro-input" type="text" name="bairro" value={prefillBairro} class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Cidade *</label>
              <input id="cidade-input" type="text" name="cidade" value={prefillCidade} required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none" />
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <h2 class="font-semibold text-gray-700 mb-3 text-sm uppercase tracking-wide">Servico</h2>
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Descricao do Servico *</label>
            <textarea name="descricao" required rows="3" placeholder="Descreva o problema ou servico solicitado..." class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none resize-none"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Horario Agendado *</label>
            <SlotPicker hiddenId="novo-horario-input" intervaloHoras={intervaloHoras} required={true} minToday={true} />
            <p class="mt-1 text-xs text-gray-400">O cliente é atendido numa janela de {intervaloHoras} horas a partir da hora escolhida.</p>
            <p id="novo-horario-warning" class="hidden mt-2 text-xs text-amber-700">Horario comprometido por outro agendamento (janela de {intervaloHoras}h).</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Tecnico Responsavel</label>
            <select name="tecnico_id" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:border-transparent outline-none bg-white">
              <option value="">Nao atribuido</option>
              {tecnicos.map((t: any) => (
                <option value={t.id}>{t.name}</option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-xl transition">
        Criar Chamado
      </button>
    </form>
  </div>

  <div id="postal-loading-overlay" class="fixed inset-0 bg-black/30 backdrop-blur-[1px] z-50 hidden items-center justify-center">
    <div class="bg-white rounded-xl px-4 py-3 shadow text-sm font-medium text-gray-700">A validar codigo postal...</div>
  </div>
</Layout>

<div id="conflict-modal" class="fixed inset-0 z-[70] hidden" aria-hidden="true">
  <button id="conflict-modal-backdrop" type="button" class="absolute inset-0 bg-black/40"></button>
  <div class="absolute inset-0 flex items-end sm:items-center sm:justify-center p-0 sm:p-4">
    <div class="w-full sm:max-w-md bg-white rounded-t-2xl sm:rounded-2xl shadow-xl border border-gray-200 p-4 sm:p-5">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base font-semibold text-gray-800">Conflito de Horario</h3>
        <button id="conflict-modal-close" type="button" class="w-8 h-8 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition">x</button>
      </div>
      <p id="conflict-modal-message" class="text-sm text-gray-600 mb-3">Este horario está comprometido.</p>
      <div class="mt-4 grid grid-cols-2 gap-2">
        <button id="conflict-modal-back" type="button" class="w-full py-2.5 rounded-lg text-sm font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50 transition">
          Voltar
        </button>
        <button id="conflict-modal-confirm" type="button" class="w-full py-2.5 rounded-lg text-sm font-semibold bg-amber-600 hover:bg-amber-700 text-white transition">
          Agendar mesmo assim
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const postalInput = document.getElementById('codigo-postal-input');
  const moradaInput = document.getElementById('morada-input');
  const bairroInput = document.getElementById('bairro-input');
  const cidadeInput = document.getElementById('cidade-input');
  const overlay = document.getElementById('postal-loading-overlay');
  const novoForm = document.getElementById('novo-chamado-form') as HTMLFormElement | null;
  const novoHorarioInput = document.getElementById('novo-horario-input') as HTMLInputElement | null;
  const novoAllowConflict = document.getElementById('novo-allow-conflict') as HTMLInputElement | null;
  const novoHorarioWarning = document.getElementById('novo-horario-warning') as HTMLParagraphElement | null;
  const conflictModal = document.getElementById('conflict-modal') as HTMLDivElement | null;
  const conflictModalBackdrop = document.getElementById('conflict-modal-backdrop') as HTMLButtonElement | null;
  const conflictModalClose = document.getElementById('conflict-modal-close') as HTMLButtonElement | null;
  const conflictModalBack = document.getElementById('conflict-modal-back') as HTMLButtonElement | null;
  const conflictModalConfirm = document.getElementById('conflict-modal-confirm') as HTMLButtonElement | null;
  const conflictModalMessage = document.getElementById('conflict-modal-message') as HTMLParagraphElement | null;
  let conflictResolver = null;
  let isSubmittingNovo = false;

  function lockScreen(lock) {
    if (!overlay) return;
    if (lock) {
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
    } else {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  function normalizePostalCode(value) {
    const digits = value.replace(/\D/g, '');
    if (digits.length < 7) return null;
    return `${digits.slice(0, 4)}-${digits.slice(4, 7)}`;
  }

  postalInput?.addEventListener('blur', async () => {
    const normalized = normalizePostalCode(postalInput.value || '');
    if (!normalized) return;
    postalInput.value = normalized;

    lockScreen(true);
    try {
      const res = await fetch(`/api/postal-code?code=${encodeURIComponent(normalized)}`);
      if (!res.ok) return;
      const data = await res.json();
      if (!data?.found) return;

      if (moradaInput) moradaInput.value = data.morada || moradaInput.value;
      if (bairroInput) bairroInput.value = data.bairro || bairroInput.value;
      if (cidadeInput) cidadeInput.value = data.cidade || cidadeInput.value;
    } finally {
      lockScreen(false);
    }
  });

  async function checkNovoConflict(datetimeValue: string) {
    if (!datetimeValue) return { conflict: false };
    try {
      const res = await fetch(`/api/chamados/conflict?datetime=${encodeURIComponent(datetimeValue)}`, { cache: 'no-store' });
      if (!res.ok) return { conflict: false };
      const data = await res.json();
      return { conflict: !!data?.conflict, conflictId: data?.conflictId };
    } catch {
      return { conflict: false };
    }
  }

  function openConflictModal(message: string) {
    if (conflictModalMessage) conflictModalMessage.textContent = message;
    conflictModal?.classList.remove('hidden');
    conflictModal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    return new Promise<boolean>((resolve) => {
      conflictResolver = resolve;
    });
  }

  function closeConflictModal(confirmed = false) {
    conflictModal?.classList.add('hidden');
    conflictModal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (conflictResolver) {
      const resolve = conflictResolver;
      conflictResolver = null;
      resolve(confirmed);
    }
  }

  async function syncNovoWarning() {
    const value = novoHorarioInput?.value || '';
    const { conflict } = await checkNovoConflict(value);
    if (!novoHorarioWarning) return;
    novoHorarioWarning.classList.toggle('hidden', !conflict);
  }

  novoHorarioInput?.addEventListener('change', syncNovoWarning);
  novoHorarioInput?.addEventListener('blur', syncNovoWarning);

  novoForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (isSubmittingNovo) return;
    isSubmittingNovo = true;
    const value = novoHorarioInput?.value || '';
    const { conflict, conflictId } = await checkNovoConflict(value);
    if (!conflict) {
      if (novoAllowConflict) novoAllowConflict.value = '0';
      novoForm.submit();
      return;
    }
    const intervaloH = novoHorarioInput?.dataset.intervalo || '3';
    const confirmed = await openConflictModal(`Horario comprometido por outro agendamento (janela de ${intervaloH}h)${conflictId ? ` - Chamado #${conflictId}` : ''}. Deseja agendar mesmo assim?`);
    if (!confirmed) {
      isSubmittingNovo = false;
      return;
    }
    if (novoAllowConflict) novoAllowConflict.value = '1';
    novoForm.submit();
  });

  conflictModalBackdrop?.addEventListener('click', () => closeConflictModal(false));
  conflictModalClose?.addEventListener('click', () => closeConflictModal(false));
  conflictModalBack?.addEventListener('click', () => closeConflictModal(false));
  conflictModalConfirm?.addEventListener('click', () => closeConflictModal(true));
</script>

