---
import Layout from '../../layouts/Layout.astro';
import { getSetting, getSettingBool, COMPANY_DEFAULTS } from '../../lib/settings';

const user = Astro.locals.user;
if (user.role !== 'admin') return Astro.redirect('/dashboard');

const empresaNome = await getSetting('empresa_nome', COMPANY_DEFAULTS.nome);
const empresaSubtitulo = await getSetting('empresa_subtitulo', COMPANY_DEFAULTS.subtitulo);
const empresaTelefone = await getSetting('empresa_telefone', COMPANY_DEFAULTS.telefone);
const empresaEmail = await getSetting('empresa_email', COMPANY_DEFAULTS.email);
const empresaWebsite = await getSetting('empresa_website', COMPANY_DEFAULTS.website);
const empresaHorario = await getSetting('empresa_horario', COMPANY_DEFAULTS.horario);
const empresaIban = await getSetting('empresa_iban', COMPANY_DEFAULTS.iban);
const empresaCondicoes = await getSetting('empresa_condicoes', COMPANY_DEFAULTS.condicoes.join('\n'));

const mbwayEnabled = await getSettingBool('mbway_enabled', false);
const paymentCashEnabled = await getSettingBool('payment_cash_enabled', true);
const paymentBankTransferEnabled = await getSettingBool('payment_bank_transfer_enabled', false);
const paymentBankIban = await getSetting('payment_bank_iban', '');
const paymentMbwayPhoneEnabled = await getSettingBool('payment_mbway_phone_enabled', false);
const paymentMbwayPhone = await getSetting('payment_mbway_phone', '');
const ivaRate = await getSetting('iva_rate', '23');
const bookingNotifyEmails = await getSetting('booking_notify_emails', 'edward.carvalho@gmail.com');
const bookingNotifyWhatsappNumbers = await getSetting('booking_notify_whatsapp_numbers', '911831978');
const bookingNotifyWhatsappCallmebotApiKey = await getSetting('booking_notify_whatsapp_callmebot_apikey', '');

const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
---
<Layout title="Configuracoes" user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center gap-3 mb-4">
      <a href="/dashboard" class="text-gray-400 hover:text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Configuracoes</h1>
        <p class="text-sm text-gray-500">Controle de integracoes e pagamentos</p>
      </div>
    </div>

    {success === 'saved' && <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">Configuracoes atualizadas.</div>}
    {error === 'server' && <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">Erro ao guardar configuracoes.</div>}

    <form method="POST" action="/api/admin/settings" class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-4">
      <h2 class="font-semibold text-gray-700 text-sm uppercase tracking-wide">MB WAY API</h2>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 cursor-pointer hover:bg-gray-50 transition">
        <input type="checkbox" name="mbway_enabled" checked={mbwayEnabled} class="mt-1 h-4 w-4 accent-red-700" />
        <span>
          <span class="block text-sm font-semibold text-gray-800">Ativar cobranca MB WAY</span>
          <span class="block text-xs text-gray-500">Permite enviar pedido de pagamento MB WAY via API para orcamentos aprovados.</span>
        </span>
      </label>

      <h2 class="font-semibold text-gray-700 text-sm uppercase tracking-wide pt-2">Metodos de Pagamento no Orcamento</h2>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 cursor-pointer hover:bg-gray-50 transition">
        <input type="checkbox" name="payment_cash_enabled" checked={paymentCashEnabled} class="mt-1 h-4 w-4 accent-red-700" />
        <span>
          <span class="block text-sm font-semibold text-gray-800">Aceita dinheiro</span>
          <span class="block text-xs text-gray-500">Mostra opcao de pagamento em dinheiro no email e WhatsApp.</span>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 cursor-pointer hover:bg-gray-50 transition">
        <input type="checkbox" name="payment_bank_transfer_enabled" checked={paymentBankTransferEnabled} class="mt-1 h-4 w-4 accent-red-700" />
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-800">Transferencia bancaria</span>
          <span class="block text-xs text-gray-500 mb-2">Envia IBAN ao cliente.</span>
          <input type="text" name="payment_bank_iban" value={paymentBankIban} placeholder="IBAN (ex: PT50...)" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 cursor-pointer hover:bg-gray-50 transition">
        <input type="checkbox" name="payment_mbway_phone_enabled" checked={paymentMbwayPhoneEnabled} class="mt-1 h-4 w-4 accent-red-700" />
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-800">MB WAY por numero</span>
          <span class="block text-xs text-gray-500 mb-2">Mostra numero para cliente pagar manualmente por MB WAY.</span>
          <input type="text" name="payment_mbway_phone" value={paymentMbwayPhone} placeholder="Telemovel MB WAY (ex: 91xxxxxxx)" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 cursor-pointer hover:bg-gray-50 transition">
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-800">Aliquota de IVA (%)</span>
          <span class="block text-xs text-gray-500 mb-2">Taxa usada para calcular o total final quando o orcamento incluir IVA.</span>
          <input type="number" name="iva_rate" value={ivaRate} min="0" max="100" step="0.01" placeholder="23" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </span>
      </label>

      <h2 class="font-semibold text-gray-700 text-sm uppercase tracking-wide pt-2">Notificacoes de Novos Agendamentos</h2>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 cursor-pointer hover:bg-gray-50 transition">
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-800">Emails de aviso</span>
          <span class="block text-xs text-gray-500 mb-2">Recebem aviso quando um cliente cria agendamento público. Separe por vírgula, ponto e vírgula ou linha.</span>
          <textarea name="booking_notify_emails" rows="3" placeholder="ex: edward.carvalho@gmail.com, outro@email.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">{bookingNotifyEmails}</textarea>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 cursor-pointer hover:bg-gray-50 transition">
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-800">Números WhatsApp de aviso</span>
          <span class="block text-xs text-gray-500 mb-2">Recebem aviso por WhatsApp via CallMeBot. Separe por vírgula, ponto e vírgula ou linha.</span>
          <textarea name="booking_notify_whatsapp_numbers" rows="3" placeholder="ex: 911831978, 351912345678" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">{bookingNotifyWhatsappNumbers}</textarea>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 cursor-pointer hover:bg-gray-50 transition">
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-800">API key CallMeBot (WhatsApp)</span>
          <span class="block text-xs text-gray-500 mb-2">Necessária para envio automático de WhatsApp pelo backend.</span>
          <input type="text" name="booking_notify_whatsapp_callmebot_apikey" value={bookingNotifyWhatsappCallmebotApiKey} placeholder="API key do CallMeBot" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </span>
      </label>

      <h2 class="font-semibold text-gray-700 text-sm uppercase tracking-wide pt-2">Dados da Empresa (PDF do orçamento)</h2>
      <p class="text-xs text-gray-500 -mt-2">Usados no cabeçalho, rodapé e condições do PDF e da página pública do orçamento.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <label class="block">
          <span class="block text-sm font-medium text-gray-700 mb-1">Nome da empresa</span>
          <input type="text" name="empresa_nome" value={empresaNome} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-gray-700 mb-1">Subtítulo</span>
          <input type="text" name="empresa_subtitulo" value={empresaSubtitulo} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-gray-700 mb-1">Telefone</span>
          <input type="text" name="empresa_telefone" value={empresaTelefone} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-gray-700 mb-1">Email</span>
          <input type="text" name="empresa_email" value={empresaEmail} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-gray-700 mb-1">Website</span>
          <input type="text" name="empresa_website" value={empresaWebsite} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-gray-700 mb-1">Horário / Cobertura</span>
          <input type="text" name="empresa_horario" value={empresaHorario} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </label>
      </div>
      <label class="block">
        <span class="block text-sm font-medium text-gray-700 mb-1">IBAN</span>
        <input type="text" name="empresa_iban" value={empresaIban} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </label>
      <label class="block">
        <span class="block text-sm font-medium text-gray-700 mb-1">Condições (uma por linha)</span>
        <textarea name="empresa_condicoes" rows="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">{empresaCondicoes}</textarea>
      </label>

      <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 rounded-lg transition text-sm">
        Guardar Configuracoes
      </button>
    </form>
  </div>
</Layout>

