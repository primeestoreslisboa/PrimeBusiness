---
import Layout from '../../../layouts/Layout.astro';
import { getMargemVenda } from '../../../lib/settings';
const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
const margem = await getMargemVenda(400);
---
<Layout title="Novo Serviço" user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center gap-3 mb-6">
      <a href="/admin/servicos" class="text-gray-400 hover:text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>
      <h1 class="text-2xl font-bold text-gray-800">Novo Serviço</h1>
    </div>
    {error && <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">❌ Erro ao criar serviço.</div>}
    <form method="POST" action="/api/servicos" class="space-y-4" id="servico-form" data-margem={margem}>
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nome *</label>
          <input type="text" name="nome" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none"/>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Descrição</label>
          <textarea name="descricao" rows="2" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none resize-none"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Custo (€) *</label>
            <input type="number" name="custo" id="custo-input" step="0.01" min="0" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Unidade</label>
            <input type="text" name="unidade" value="unidade" list="unidade-options" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none"/>
            <datalist id="unidade-options"><option value="unidade"></option><option value="m²"></option><option value="ml"></option></datalist>
          </div>
        </div>
        <div class="bg-green-50 border border-green-100 rounded-lg px-3 py-2 flex items-center justify-between">
          <span class="text-sm text-green-800 font-medium">Preço de venda (margem {margem}%)</span>
          <span id="venda-preview" class="font-bold text-green-800 text-lg">€0.00</span>
        </div>
      </div>
      <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-xl transition">Criar Serviço</button>
    </form>

    <script>
      const form = document.getElementById('servico-form') as HTMLFormElement | null;
      if (form) {
        const margem = parseFloat(form.dataset.margem || '400') || 400;
        const custoInput = document.getElementById('custo-input') as HTMLInputElement | null;
        const preview = document.getElementById('venda-preview');
        const fmt = (n: number) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
        const update = () => {
          const custo = parseFloat((custoInput?.value || '0').replace(',', '.')) || 0;
          if (preview) preview.textContent = `€${fmt(custo * (margem / 100))}`;
        };
        custoInput?.addEventListener('input', update);
        update();
      }
    </script>
  </div>
</Layout>

