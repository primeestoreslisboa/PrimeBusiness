---
import Layout from '../../../layouts/Layout.astro';
import { getDb } from '../../../lib/db';
const user = Astro.locals.user;
const sql = getDb();
const servicos = await sql`SELECT * FROM servicos WHERE ativo = true ORDER BY nome`;
const success = Astro.url.searchParams.get('success');
const successMsg: Record<string, string> = {
  deleted: 'Produto eliminado.',
  disabled: 'Produto em uso no histórico — foi desativado e removido do catálogo.',
  '1': 'Operação realizada!',
};
---
<Layout title="Serviços" user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Catálogo de Serviços</h1>
      <a href="/admin/servicos/novo" class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">+ Novo</a>
    </div>
    {success && <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">✅ {successMsg[success] ?? 'Operação realizada!'}</div>}
    <div class="space-y-2">
      {servicos.map((s: any) => (
        <div class={`relative bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition ${!s.ativo ? 'opacity-50' : ''}`}>
          <a href={`/admin/servicos/${s.id}`} class="flex items-center justify-between px-4 py-3 pr-14">
            <div class="flex-1">
              <p class="font-medium text-gray-800">{s.nome}</p>
              {s.descricao && <p class="text-xs text-gray-500 truncate">{s.descricao}</p>}
            </div>
            <div class="text-right flex-shrink-0 ml-3">
              <p class="font-semibold text-red-700">€{parseFloat(s.preco).toFixed(2)}</p>
              {s.custo != null && <p class="text-xs text-gray-400">custo €{parseFloat(s.custo).toFixed(2)}</p>}
              <p class="text-xs text-gray-400">/{s.unidade}</p>
            </div>
          </a>
          <form method="POST" action={`/api/servicos/${s.id}`}
            data-confirm="Eliminar este serviço?"
            class="absolute top-2 right-3">
            <input type="hidden" name="_method" value="DELETE" />
            <button type="submit"
              class="w-8 h-8 flex items-center justify-center rounded-lg bg-red-50 hover:bg-red-100 text-red-500 hover:text-red-700 transition"
              title="Eliminar">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-6 0h6" />
              </svg>
            </button>
          </form>
        </div>
      ))}
    </div>
  </div>
</Layout>

