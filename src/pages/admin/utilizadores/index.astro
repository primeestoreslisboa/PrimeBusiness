---
import Layout from '../../../layouts/Layout.astro';
import { getDb } from '../../../lib/db';
const user = Astro.locals.user;
if (user.role !== 'admin') return Astro.redirect('/dashboard');
const sql = getDb();
const utilizadores = await sql`SELECT id, name, email, role, created_at FROM users WHERE deleted_at IS NULL ORDER BY name`;
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
---
<Layout title="Utilizadores" user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Utilizadores</h1>
      <a href="/admin/utilizadores/novo" class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">+ Novo</a>
    </div>
    {success && <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">Operacao realizada com sucesso.</div>}
    {error === 'self_delete' && <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 rounded-lg px-4 py-3 mb-4 text-sm">Nao e permitido eliminar o utilizador atual.</div>}
    {error === 'delete_failed' && <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">Nao foi possivel eliminar este utilizador.</div>}
    <div class="space-y-3">
      {utilizadores.map((u: any) => (
        <div class="relative bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <a href={`/admin/utilizadores/${u.id}`} class="flex items-center justify-between p-4 pr-14">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center text-red-800 font-bold text-sm flex-shrink-0">
                {u.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="font-medium text-gray-800">{u.name}</p>
                <p class="text-xs text-gray-500">Usuario: {u.email}</p>
              </div>
            </div>
            <span class={`text-xs px-2 py-1 rounded-full font-medium ${u.role === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-600'}`}>
              {u.role}
            </span>
          </a>
          <form method="POST" action={`/api/utilizadores/${u.id}`}
            onsubmit={u.id === user.userId ? 'return false' : undefined}
            data-confirm={u.id === user.userId ? undefined : 'Eliminar este utilizador?'}
            class="absolute top-3 right-3">
            <input type="hidden" name="_method" value="DELETE" />
            <button type="submit"
              disabled={u.id === user.userId}
              class={`w-8 h-8 flex items-center justify-center rounded-lg transition ${u.id === user.userId ? 'bg-gray-100 text-gray-300 cursor-not-allowed' : 'bg-red-50 hover:bg-red-100 text-red-500 hover:text-red-700'}`}
              title={u.id === user.userId ? 'Nao pode eliminar o utilizador atual' : 'Eliminar'}>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-6 0h6" />
              </svg>
            </button>
          </form>
        </div>
      ))}
    </div>
  </div>
</Layout>

