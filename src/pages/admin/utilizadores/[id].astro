---
import Layout from '../../../layouts/Layout.astro';
import { getDb } from '../../../lib/db';
const user = Astro.locals.user;
if (user.role !== 'admin') return Astro.redirect('/dashboard');
const { id } = Astro.params;
const sql = getDb();
const [u] = await sql`SELECT id, name, email, role FROM users WHERE id = ${id} AND deleted_at IS NULL`;
if (!u) return Astro.redirect('/admin/utilizadores');
const success = Astro.url.searchParams.get('success');
const error   = Astro.url.searchParams.get('error');
---
<Layout title={`Utilizador - ${u.name}`} user={user}>
  <div class="py-6 pb-24">
    <div class="flex items-center gap-3 mb-6">
      <a href="/admin/utilizadores" class="text-gray-400 hover:text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>
      <h1 class="text-2xl font-bold text-gray-800">{u.name}</h1>
    </div>
    {success && <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 mb-4 text-sm">Utilizador atualizado.</div>}
    {error   && <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">Erro ao guardar.</div>}
    <form method="POST" action={`/api/utilizadores/${id}`} class="space-y-4">
      <input type="hidden" name="_method" value="PUT"/>
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nome *</label>
          <input type="text" name="name" value={u.name} required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none"/>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Usuario (email ou nome) *</label>
          <input type="text" name="email" value={u.email} required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none"/>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nova Senha <span class="text-gray-400 font-normal">(deixar vazio para nao alterar)</span></label>
          <input type="password" name="password" minlength="6" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none"/>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Perfil</label>
          <select name="role" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none bg-white">
            <option value="tecnico" selected={u.role === 'tecnico'}>Tecnico</option>
            <option value="admin" selected={u.role === 'admin'}>Administrador</option>
          </select>
        </div>
      </div>
      <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-xl transition">Guardar Alteracoes</button>
    </form>
    {u.id !== user.userId && (
      <form method="POST" action={`/api/utilizadores/${id}`} data-confirm="Eliminar este utilizador?">
        <input type="hidden" name="_method" value="DELETE"/>
        <button type="submit" class="w-full mt-2 bg-white hover:bg-red-50 border border-red-200 text-red-600 font-medium py-3 rounded-xl transition flex items-center justify-center gap-2 text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          Eliminar Utilizador
        </button>
      </form>
    )}
  </div>
</Layout>
