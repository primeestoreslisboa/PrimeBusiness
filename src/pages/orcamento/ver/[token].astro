---
import { getDb } from '../../../lib/db';
import { getCompanyInfo } from '../../../lib/settings';
import { loadOrcamentoByToken, num, computeTotals } from '../../../lib/orcamentos';

const sql = getDb();
const { token } = Astro.params;
const loaded = token ? await loadOrcamentoByToken(sql, token) : null;
const company = await getCompanyInfo();

const eur = (n: number) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
---
<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#8B1A1A" />
  <title>{loaded ? `${loaded.orc.numero ?? 'Orçamento'} | ${company.nome}` : 'Orçamento'}</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: #f3f4f6; color: #1f2937; }
    .wrap { max-width: 720px; margin: 0 auto; padding: 16px; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; }
    .head { display: flex; align-items: center; gap: 12px; padding: 18px 20px; border-bottom: 3px solid #8B1A1A; }
    .head img { width: 52px; height: 52px; object-fit: contain; }
    .head h1 { margin: 0; color: #8B1A1A; font-size: 20px; }
    .head p { margin: 2px 0 0; color: #6b7280; font-size: 12px; }
    .contact { margin-left: auto; text-align: right; font-size: 11px; color: #374151; line-height: 1.5; }
    .body { padding: 20px; }
    .title { font-size: 22px; font-weight: bold; margin: 0; }
    .sub { color: #6b7280; font-size: 13px; margin: 2px 0 16px; }
    .meta { font-size: 13px; color: #374151; margin-bottom: 16px; }
    .sect { background: #8B1A1A; color: #fff; font-size: 12px; font-weight: bold; padding: 6px 10px; border-radius: 6px; margin: 18px 0 8px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { padding: 8px; border-bottom: 1px solid #eee; text-align: left; }
    th { background: #f2f2f2; }
    td.num, th.num { text-align: right; }
    .totals { margin-top: 12px; margin-left: auto; width: 260px; font-size: 14px; }
    .totals div { display: flex; justify-content: space-between; padding: 3px 0; }
    .totals .grand { font-weight: bold; color: #8B1A1A; font-size: 16px; border-top: 2px solid #8B1A1A; padding-top: 6px; }
    .cond { font-size: 12px; color: #374151; line-height: 1.6; }
    .dl { display: block; text-align: center; background: #8B1A1A; color: #fff; text-decoration: none; padding: 14px; border-radius: 10px; font-weight: bold; margin: 8px 0 18px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; font-size: 13px; }
    .grid .lbl { color: #6b7280; font-size: 11px; }
    .foot { text-align: center; color: #9ca3af; font-size: 11px; padding: 16px; }
    @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } .contact { display: none; } }
  </style>
</head>
<body>
  <div class="wrap">
    {!loaded ? (
      <div class="card"><div class="body"><h1 class="title">Orçamento não encontrado</h1><p class="sub">O link pode estar incorreto ou expirado.</p></div></div>
    ) : (
      <div class="card">
        <div class="head">
          <img src="/logo-prime.png" alt={company.nome} />
          <div>
            <h1>{company.nome.toUpperCase()}</h1>
            <p>{company.subtitulo}</p>
          </div>
          <div class="contact">
            {company.telefone}<br/>{company.email}<br/>{company.website}
          </div>
        </div>
        <div class="body">
          <p class="title">ORÇAMENTO</p>
          <p class="sub">Proposta de serviço sem compromisso</p>
          <div class="meta">
            <strong>N.º:</strong> {loaded.orc.numero ?? `#${loaded.orc.id}`} &nbsp;·&nbsp;
            <strong>Data:</strong> {new Date(loaded.orc.created_at).toLocaleDateString('pt-PT')} &nbsp;·&nbsp;
            <strong>Validade:</strong> {loaded.orc.validade_dias} dias
          </div>

          <a class="dl" href={`/orcamento/pdf/${token}`}>⬇ Descarregar PDF</a>

          <div class="sect">DADOS DO CLIENTE</div>
          <div class="grid">
            <div><div class="lbl">Nome / Empresa</div>{loaded.orc.cliente_nome}</div>
            <div><div class="lbl">NIF</div>{loaded.orc.cliente_nif ?? '—'}</div>
            <div><div class="lbl">Morada</div>{loaded.orc.cliente_morada ?? '—'}</div>
            <div><div class="lbl">Cód. Postal / Localidade</div>{[loaded.orc.cliente_codigo_postal, loaded.orc.cliente_localidade].filter(Boolean).join(' ') || '—'}</div>
            <div><div class="lbl">Telefone</div>{loaded.orc.cliente_telefone ?? '—'}</div>
            <div><div class="lbl">Email</div>{loaded.orc.cliente_email ?? '—'}</div>
          </div>

          <div class="sect">PEÇAS E SERVIÇOS</div>
          <table>
            <thead>
              <tr>
                <th style="width:28px">#</th>
                <th>Descrição</th>
                <th class="num" style="width:50px">Qtd.</th>
                <th class="num" style="width:90px">Preço Unit. (€)</th>
                <th class="num" style="width:90px">Total (€)</th>
              </tr>
            </thead>
            <tbody>
              {loaded.itens.map((it: any, i: number) => (
                <tr>
                  <td>{i + 1}</td>
                  <td>{it.descricao}</td>
                  <td class="num">{num(it.quantidade)}</td>
                  <td class="num">{eur(num(it.preco_unitario))}</td>
                  <td class="num">{eur(num(it.quantidade) * num(it.preco_unitario))}</td>
                </tr>
              ))}
            </tbody>
          </table>

          {(() => {
            const t = computeTotals(loaded.itens.map((it: any) => ({ quantidade: num(it.quantidade), preco_unitario: num(it.preco_unitario) })), !!loaded.orc.include_iva, num(loaded.orc.iva_rate));
            return (
              <div class="totals">
                <div><span>Subtotal</span><span>{eur(t.subtotal)} €</span></div>
                {loaded.orc.include_iva && <div><span>IVA ({num(loaded.orc.iva_rate).toFixed(0)}%)</span><span>{eur(t.ivaValue)} €</span></div>}
                <div class="grand"><span>TOTAL</span><span>{eur(t.total)} €</span></div>
              </div>
            );
          })()}

          <div class="sect">CONDIÇÕES</div>
          <div class="cond">
            {company.condicoes.map((line: string) => (
              <div>• {line.toLowerCase().startsWith('pagamento') ? `Pagamento: transferência bancária, MB Way ou numerário. IBAN: ${company.iban}.` : line}</div>
            ))}
          </div>

          {loaded.orc.observacoes && (
            <>
              <div class="sect">OBSERVAÇÕES</div>
              <div class="cond">{loaded.orc.observacoes}</div>
            </>
          )}
        </div>
        <div class="foot">{[company.nome, 'Grande Lisboa', company.telefone, company.email].filter(Boolean).join('  ·  ')}</div>
      </div>
    )}
  </div>
</body>
</html>
