---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/db';
import { getAgendamentoIntervaloHoras } from '../lib/settings';
import { timeRangeLabel, dateTimeRangeLabel } from '../lib/horario';

const user = Astro.locals.user;
const sql  = getDb();
const intervaloHoras = await getAgendamentoIntervaloHoras(3);

const dateParam = Astro.url.searchParams.get('date');
const selDate   = dateParam ? new Date(dateParam + 'T12:00:00') : new Date();
const selYear   = selDate.getFullYear();
const selMonth  = selDate.getMonth();
const selDay    = selDate.getDate();

const selStart = new Date(selYear, selMonth, selDay);
const selEnd   = new Date(selYear, selMonth, selDay + 1);

const chamadosDia = await sql`
  SELECT c.*, u.name as tecnico_nome
  FROM chamados c LEFT JOIN users u ON c.tecnico_id = u.id
  WHERE c.horario_agendado >= ${selStart.toISOString()} AND c.horario_agendado < ${selEnd.toISOString()}
  ORDER BY c.horario_agendado ASC
`;

const chamadosDiaConsumidos = chamadosDia.filter(
  (c: any) => c.status !== 'concluido' && c.status !== 'cancelado'
);

// Orçamentos diretos associados aos chamados do dia (para acesso rápido).
const diaIds = chamadosDia.map((c: any) => c.id);
const orcamentosDia = diaIds.length > 0
  ? await sql`
      SELECT id, numero, total, status, observacoes, chamado_id
      FROM orcamentos_diretos
      WHERE chamado_id = ANY(${diaIds})
      ORDER BY created_at DESC
    `
  : [];
const orcPorChamado = new Map<number, any[]>();
for (const o of orcamentosDia) {
  const arr = orcPorChamado.get(o.chamado_id) ?? [];
  arr.push(o);
  orcPorChamado.set(o.chamado_id, arr);
}
const eur = (n: any) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Number.parseFloat(String(n ?? '0')) || 0);
const menuItem = 'menu-item flex items-center gap-3 w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition';

const monthStart = new Date(selYear, selMonth, 1);
const monthEnd   = new Date(selYear, selMonth + 1, 1);

const chamadosMes = await sql`
  SELECT id, horario_agendado, status
  FROM chamados
  WHERE horario_agendado >= ${monthStart.toISOString()} AND horario_agendado < ${monthEnd.toISOString()}
`;

const chamadosMesConsumidos = chamadosMes.filter(
  (c: any) => c.status !== 'cancelado'
);

const [stats] = await sql`
  SELECT
    COUNT(*) FILTER (WHERE status='pendente')     as pendentes,
    COUNT(*) FILTER (WHERE status='em_andamento') as em_andamento,
    COUNT(*) FILTER (WHERE status='concluido' AND DATE(horario_agendado)=CURRENT_DATE) as concluidos_hoje,
    COUNT(*) FILTER (WHERE horario_agendado >= ${monthStart.toISOString()} AND horario_agendado < ${monthEnd.toISOString()}) as total
  FROM chamados
`;

const porDia: Record<number,number> = {};
for (const c of chamadosMesConsumidos) {
  const d = new Date(c.horario_agendado).getDate();
  porDia[d] = (porDia[d] || 0) + 1;
}

const today       = new Date();
const isToday     = selYear === today.getFullYear() && selMonth === today.getMonth() && selDay === today.getDate();
const daysInMonth = new Date(selYear, selMonth + 1, 0).getDate();
const firstDow    = new Date(selYear, selMonth, 1).getDay();
const offset      = firstDow === 0 ? 6 : firstDow - 1;

const MONTHS = ['Janeiro','Fevereiro','Marco','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const STATUS_CLS: Record<string,string> = {
  pendente:'bg-yellow-100 text-yellow-800', em_andamento:'bg-blue-100 text-blue-800',
  concluido:'bg-green-100 text-green-800',  cancelado:'bg-red-100 text-red-800',
};
const STATUS_LABEL: Record<string,string> = {
  pendente: 'Pendente',
  em_andamento: 'Em andamento',
  concluido: 'Concluido',
  cancelado: 'Cancelado',
};
const fmt = (d:string) => new Date(d).toLocaleTimeString('pt-PT',{hour:'2-digit',minute:'2-digit'});
const timelineRows = Array.from({ length: 14 }, (_, i) => {
  const hour = i + 7;
  const slotAt = new Date(selYear, selMonth, selDay, hour, 0, 0, 0);
  const evs = chamadosDiaConsumidos
    .filter((c: any) => {
      const startHour = new Date(c.horario_agendado).getHours();
      return hour >= startHour && hour < startHour + intervaloHoras;
    })
    .map((c: any) => {
      const startHour = new Date(c.horario_agendado).getHours();
      return {
        ...c,
        isContinuation: hour > startHour,
      };
    });
  const isPastEmpty = slotAt < today && evs.length === 0;
  return { hour, evs, hidden: isPastEmpty };
}).filter((row) => !row.hidden);

const prevM = new Date(selYear, selMonth - 1, 1);
const nextM = new Date(selYear, selMonth + 1, 1);
const dayLink = (d: number) => `?date=${selYear}-${String(selMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;

function buildCopyText(c: any) {
  const local = [c.morada, c.codigo_postal, c.bairro, c.cidade].filter(Boolean).join(', ');
  return [
    `Novo agendamento #${c.id}`,
    `*Cliente*: ${c.nome ?? ''}`,
    `*Telefone:* ${c.telefone ?? ''}`,
    `*Horario:* ${dateTimeRangeLabel(c.horario_agendado, intervaloHoras)}`,
    `*Morada:* ${local}`,
    `*Descricao:* ${c.descricao ?? ''}`,
  ].join('\n');
}
---
<Layout title="Dashboard" user={user}>
  <div class="py-6 pb-24">

    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">
          {isToday ? `Bom dia, ${user.name.split(' ')[0]}!` : `${selDay} de ${MONTHS[selMonth]}`}
        </h1>
        <p class="text-gray-500 text-sm">{selDate.toLocaleDateString('pt-PT',{weekday:'long',year:'numeric',month:'long',day:'numeric'})}</p>
      </div>
      {!isToday && <a href="/dashboard" class="text-sm text-red-700 border border-red-200 rounded-lg px-3 py-1.5 hover:bg-red-50 transition">Hoje</a>}
    </div>

    <div class="grid grid-cols-2 gap-3 mb-5 sm:grid-cols-4">
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <p class="text-2xl font-bold text-yellow-500">{stats.pendentes}</p>
        <p class="text-xs text-gray-500 mt-1">Pendentes</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <p class="text-2xl font-bold text-blue-600">{stats.em_andamento}</p>
        <p class="text-xs text-gray-500 mt-1">Em Andamento</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <p class="text-2xl font-bold text-green-500">{stats.concluidos_hoje}</p>
        <p class="text-xs text-gray-500 mt-1">Concluidos Hoje</p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <p class="text-2xl font-bold text-gray-700">{stats.total}</p>
        <p class="text-xs text-gray-500 mt-1">Total</p>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-5">
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
        <a href={`?date=${prevM.getFullYear()}-${String(prevM.getMonth()+1).padStart(2,'0')}-01`}
           class="p-1.5 rounded-lg hover:bg-gray-100 transition text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </a>
        <h2 class="font-semibold text-gray-800">{MONTHS[selMonth]} {selYear}</h2>
        <a href={`?date=${nextM.getFullYear()}-${String(nextM.getMonth()+1).padStart(2,'0')}-01`}
           class="p-1.5 rounded-lg hover:bg-gray-100 transition text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-7 border-b border-gray-100">
        {['Seg','Ter','Qua','Qui','Sex','Sab','Dom'].map(d => (
          <div class="py-2 text-center text-xs font-medium text-gray-400">{d}</div>
        ))}
      </div>
      <div class="grid grid-cols-7">
        {Array.from({length: offset}, () => (
          <div class="h-12 border-b border-r border-gray-50 last:border-r-0"/>
        ))}
        {Array.from({length: daysInMonth}, (_,i) => {
          const d    = i + 1;
          const isSel= d === selDay;
          const isTod= d === today.getDate() && selMonth === today.getMonth() && selYear === today.getFullYear();
          const cnt  = porDia[d] || 0;
          const col  = (offset + d - 1) % 7;
          const isWe = col >= 5;
          return (
            <a href={dayLink(d)}
               class={`h-12 flex flex-col items-center justify-center border-b border-r border-gray-50 transition relative
                 ${isSel ? 'bg-red-700' : isTod ? 'bg-red-50' : isWe ? 'bg-gray-50/60 hover:bg-gray-100' : 'hover:bg-gray-50'}`}>
              <span class={`text-sm font-medium leading-none
                ${isSel ? 'text-white' : isTod ? 'text-red-700 font-bold' : isWe ? 'text-gray-400' : 'text-gray-700'}`}>{d}</span>
              {cnt > 0 && (
                <span class={`mt-0.5 text-xs leading-none font-semibold ${isSel ? 'text-red-200' : 'text-red-600'}`}>{cnt}</span>
              )}
            </a>
          );
        })}
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-5">
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
        <h2 class="font-semibold text-gray-800 flex items-center gap-2">
          Agenda - {selDay} de {MONTHS[selMonth]}
          {chamadosDiaConsumidos.length > 0 && <span class="bg-red-100 text-red-800 text-xs px-2 py-0.5 rounded-full">{chamadosDiaConsumidos.length}</span>}
        </h2>
        <a href="/chamados/novo" class="text-sm text-green-600 font-medium">+ Novo</a>
      </div>
      {chamadosDia.length === 0 ? (
        <div class="px-4 py-8 text-center text-gray-400">
          <p class="text-4xl mb-2">Agenda</p>
          <p class="text-sm">Nenhum chamado para este dia</p>
        </div>
      ) : (
        <div class="divide-y divide-gray-50">
          {chamadosDia.map((c: any) => {
            const orcs = orcPorChamado.get(c.id) ?? [];
            const orc = orcs[0];
            return (
            <div class="relative hover:bg-gray-50 transition">
              <a href={`/chamados/${c.id}`} class="flex items-start gap-3 px-4 py-3 pr-16">
                <div class="min-w-[92px] pt-0.5">
                  <p class="text-xs font-bold text-red-700 leading-tight">{timeRangeLabel(c.horario_agendado, intervaloHoras)}</p>
                  <span class={`inline-block mt-1 text-xs px-2 py-0.5 rounded-full font-medium ${STATUS_CLS[c.status] || 'bg-gray-100 text-gray-800'}`}>{STATUS_LABEL[c.status] || c.status}</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-gray-800 truncate">{c.nome}</p>
                  <p class="text-xs text-gray-500 truncate">{c.cidade} - {c.descricao.substring(0,50)}{c.descricao.length>50?'...':''}</p>
                  {orcs.length > 0 && (
                    <div class="mt-1 space-y-0.5">
                      {orcs.map((o: any) => (
                        <p class="text-xs text-gray-500 truncate">
                          {o.numero ?? `Orçamento #${o.id}`} | EUR {eur(o.total)}{o.observacoes ? ` | ${o.observacoes}` : ''}
                        </p>
                      ))}
                    </div>
                  )}
                </div>
              </a>
              <div class="absolute right-3 top-3 kebab">
                <button type="button" title="Opções" aria-haspopup="true" aria-expanded="false"
                        class="kebab-toggle w-9 h-9 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 pointer-events-none" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
                </button>
                <div class="kebab-menu hidden absolute right-full mr-1 top-0 w-60 bg-white rounded-xl shadow-lg border border-gray-200 py-1 z-[60]">
                  <a href={`/chamados/${c.id}`} class={menuItem}>
                    <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    Abrir chamado
                  </a>
                  <button type="button" class={`${menuItem} copy-agendamento`} data-copy={buildCopyText(c)}>
                    <svg class="w-4 h-4 text-gray-500 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9h6m-6 3h4"/></svg>
                    Copiar detalhes (WhatsApp)
                  </button>
                  {orcs.map((o: any) => (
                    <a href={`/orcamentos/${o.id}/editar`} class={menuItem}>
                      <svg class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      Abrir {o.numero ?? `orçamento #${o.id}`}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
          })}
        </div>
      )}
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100">
      <div class="px-4 py-3 border-b border-gray-100">
        <h2 class="font-semibold text-gray-800">Timeline - {selDay}/{selMonth+1}/{selYear}</h2>
      </div>
      <div class="px-4 py-3">
        {timelineRows.map(({ hour, evs }) => (
            <div class="flex items-start gap-2 mb-1">
              <span class="text-xs text-gray-400 w-10 pt-1 flex-shrink-0 font-mono">{hour}:00</span>
              <div class={`flex-1 border-t border-dashed border-gray-200 pt-1 ${evs.length>0?'min-h-[36px]':'min-h-[20px]'}`}>
                {evs.map((c:any) => (
                  <a href={`/chamados/${c.id}`}
                     class={`block mb-1 text-white text-xs px-2 py-1 rounded truncate hover:opacity-90 transition
                       ${c.status==='concluido'?'bg-green-500':c.status==='cancelado'?'bg-red-500':c.status==='em_andamento'?'bg-blue-500':'bg-yellow-500'}`}>
                    {c.isContinuation ? `Em curso - ${c.nome}` : `${timeRangeLabel(c.horario_agendado, intervaloHoras)} - ${c.nome}`}
                  </a>
                ))}
              </div>
            </div>
        ))}
      </div>
    </div>

  </div>

  <script>
    // Menu de três pontinhos (kebab)
    function closeAllKebabs() {
      document.querySelectorAll('.kebab-menu').forEach(m => m.classList.add('hidden'));
      document.querySelectorAll('.kebab-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));
    }
    document.querySelectorAll('.kebab-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const menu = btn.parentElement?.querySelector('.kebab-menu') as HTMLElement | null;
        const isOpen = !!menu && !menu.classList.contains('hidden');
        closeAllKebabs();
        if (menu && !isOpen) {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          // Posiciona como fixed para escapar de qualquer recorte do card.
          const r = (btn as HTMLElement).getBoundingClientRect();
          const mw = menu.offsetWidth;
          const mh = menu.offsetHeight;
          menu.style.position = 'fixed';
          menu.style.right = 'auto';
          menu.style.marginRight = '0';
          let left = r.left - mw - 6;
          if (left < 8) left = Math.min(r.right + 6, window.innerWidth - mw - 8);
          let top = r.top;
          if (top + mh > window.innerHeight - 8) top = window.innerHeight - mh - 8;
          if (top < 8) top = 8;
          menu.style.left = left + 'px';
          menu.style.top = top + 'px';
        }
      });
    });
    document.addEventListener('click', closeAllKebabs);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAllKebabs(); });

    document.querySelectorAll('.copy-agendamento').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const text = btn.getAttribute('data-copy') || '';
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { ok = document.execCommand('copy'); } catch { ok = false; }
          document.body.removeChild(ta);
        }
        const original = btn.innerHTML;
        btn.textContent = ok ? '✓' : '✕';
        setTimeout(() => { btn.innerHTML = original; }, 1200);
      });
    });
  </script>
</Layout>
