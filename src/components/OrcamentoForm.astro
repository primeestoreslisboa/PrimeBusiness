---
import { num } from '../lib/orcamentos';

export interface Props {
  action: string;
  actionName?: string | null;
  submitLabel: string;
  ivaRate: number;
  orc?: any;
  itens?: any[];
}
const { action, actionName = null, submitLabel, ivaRate, orc = null, itens = [] } = Astro.props;

const includeIva = orc ? !!orc.include_iva : true;
const validade = orc ? (orc.validade_dias ?? 30) : 30;
const rows = itens.length > 0 ? itens : [{ descricao: '', quantidade: 1, preco_unitario: '' }];
const inputCls = 'w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none';
---
<form method="POST" action={action} class="space-y-4" id="orc-form" data-iva-rate={ivaRate}>
  {actionName && <input type="hidden" name="action" value={actionName} />}

  <!-- DADOS DO CLIENTE -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3">
    <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wide">Dados do Cliente</h2>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nome / Empresa *</label>
      <input type="text" name="cliente_nome" required value={orc?.cliente_nome ?? ''} class={inputCls} />
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">NIF / Contribuinte</label>
        <input type="text" name="cliente_nif" value={orc?.cliente_nif ?? ''} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Telefone</label>
        <input type="text" name="cliente_telefone" value={orc?.cliente_telefone ?? ''} class={inputCls} />
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
      <input type="email" name="cliente_email" value={orc?.cliente_email ?? ''} class={inputCls} />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Morada</label>
      <input type="text" name="cliente_morada" value={orc?.cliente_morada ?? ''} class={inputCls} />
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Cód. Postal</label>
        <input type="text" name="cliente_codigo_postal" value={orc?.cliente_codigo_postal ?? ''} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Localidade</label>
        <input type="text" name="cliente_localidade" value={orc?.cliente_localidade ?? ''} class={inputCls} />
      </div>
    </div>
  </div>

  <!-- PEÇAS E SERVIÇOS -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
    <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wide mb-3">Peças e Serviços</h2>
    <div id="itens-list" class="space-y-2">
      {rows.map((it: any) => (
        <div class="orc-item grid grid-cols-12 gap-2 items-start">
          <div class="col-span-12 sm:col-span-6">
            <input type="text" name="item_desc" placeholder="Descrição da peça / serviço" value={it.descricao ?? ''} class={inputCls} />
          </div>
          <div class="col-span-3 sm:col-span-2">
            <input type="number" name="item_qtd" step="1" min="0" placeholder="Qtd" value={it.quantidade ?? 1} class={`${inputCls} item-qtd text-center`} />
          </div>
          <div class="col-span-5 sm:col-span-2">
            <input type="number" name="item_preco" step="0.01" min="0" placeholder="Preço €" value={it.preco_unitario ?? ''} class={`${inputCls} item-preco text-right`} />
          </div>
          <div class="col-span-3 sm:col-span-1 flex items-center h-full">
            <span class="item-total text-sm text-gray-600 w-full text-right">0,00</span>
          </div>
          <div class="col-span-1 flex items-center justify-end h-full">
            <button type="button" class="remove-item w-8 h-8 flex items-center justify-center rounded-lg bg-red-50 hover:bg-red-100 text-red-500" title="Remover">✕</button>
          </div>
        </div>
      ))}
    </div>
    <button type="button" id="add-item" class="mt-3 text-sm text-red-700 font-medium hover:underline">+ Adicionar linha</button>
  </div>

  <!-- TOTAIS / IVA -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3">
    <label class="flex items-center gap-2 text-sm text-gray-700">
      <input type="checkbox" name="include_iva" id="include-iva" checked={includeIva} class="w-4 h-4 accent-red-700" />
      Incluir IVA ({ivaRate}%)
    </label>
    <div class="text-sm space-y-1 pt-2 border-t border-gray-100">
      <div class="flex justify-between"><span class="text-gray-500">Subtotal</span><span id="sum-subtotal" class="font-medium text-gray-700">0,00 €</span></div>
      <div class="flex justify-between" id="sum-iva-row"><span class="text-gray-500">IVA</span><span id="sum-iva" class="font-medium text-gray-700">0,00 €</span></div>
      <div class="flex justify-between text-base pt-1"><span class="font-bold text-gray-800">TOTAL</span><span id="sum-total" class="font-bold text-red-700">0,00 €</span></div>
    </div>
  </div>

  <!-- OPÇÕES -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3">
    {orc && (
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Estado</label>
        <select name="status" class={`${inputCls} max-w-[200px]`}>
          {['rascunho', 'enviado', 'aprovado', 'rejeitado'].map(s => (
            <option value={s} selected={orc.status === s}>
              {s === 'rascunho' ? 'Rascunho' : s === 'enviado' ? 'Enviado' : s === 'aprovado' ? 'Aprovado' : 'Rejeitado'}
            </option>
          ))}
        </select>
      </div>
    )}
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Validade (dias)</label>
      <input type="number" name="validade_dias" min="1" value={validade} class={`${inputCls} max-w-[120px]`} />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Observações</label>
      <textarea name="observacoes" rows="3" class={`${inputCls} resize-none`}>{orc?.observacoes ?? ''}</textarea>
    </div>
  </div>

  <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-xl transition">{submitLabel}</button>
</form>

<template id="item-template">
  <div class="orc-item grid grid-cols-12 gap-2 items-start">
    <div class="col-span-12 sm:col-span-6">
      <input type="text" name="item_desc" placeholder="Descrição da peça / serviço" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
    </div>
    <div class="col-span-3 sm:col-span-2">
      <input type="number" name="item_qtd" step="1" min="0" placeholder="Qtd" value="1" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none item-qtd text-center" />
    </div>
    <div class="col-span-5 sm:col-span-2">
      <input type="number" name="item_preco" step="0.01" min="0" placeholder="Preço €" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none item-preco text-right" />
    </div>
    <div class="col-span-3 sm:col-span-1 flex items-center h-full">
      <span class="item-total text-sm text-gray-600 w-full text-right">0,00</span>
    </div>
    <div class="col-span-1 flex items-center justify-end h-full">
      <button type="button" class="remove-item w-8 h-8 flex items-center justify-center rounded-lg bg-red-50 hover:bg-red-100 text-red-500" title="Remover">✕</button>
    </div>
  </div>
</template>

<script>
  const form = document.getElementById('orc-form') as HTMLFormElement | null;
  if (form) {
    const ivaRate = parseFloat(form.dataset.ivaRate || '23') || 23;
    const list = document.getElementById('itens-list')!;
    const tmpl = document.getElementById('item-template') as HTMLTemplateElement;
    const includeIva = document.getElementById('include-iva') as HTMLInputElement;
    const fmt = (n: number) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

    function recalc() {
      let subtotal = 0;
      list.querySelectorAll('.orc-item').forEach(row => {
        const q = parseFloat((row.querySelector('.item-qtd') as HTMLInputElement)?.value.replace(',', '.') || '0') || 0;
        const p = parseFloat((row.querySelector('.item-preco') as HTMLInputElement)?.value.replace(',', '.') || '0') || 0;
        const lineTotal = q * p;
        const cell = row.querySelector('.item-total');
        if (cell) cell.textContent = fmt(lineTotal);
        subtotal += lineTotal;
      });
      const ivaOn = includeIva?.checked;
      const iva = ivaOn ? subtotal * (ivaRate / 100) : 0;
      const total = subtotal + iva;
      document.getElementById('sum-subtotal')!.textContent = fmt(subtotal) + ' €';
      document.getElementById('sum-iva')!.textContent = fmt(iva) + ' €';
      document.getElementById('sum-total')!.textContent = fmt(total) + ' €';
      const ivaRow = document.getElementById('sum-iva-row');
      if (ivaRow) ivaRow.style.display = ivaOn ? '' : 'none';
    }

    function bindRow(row: Element) {
      row.querySelector('.remove-item')?.addEventListener('click', () => {
        if (list.querySelectorAll('.orc-item').length > 1) {
          row.remove();
        } else {
          row.querySelectorAll('input').forEach(i => { (i as HTMLInputElement).value = (i as HTMLInputElement).name === 'item_qtd' ? '1' : ''; });
        }
        recalc();
      });
    }

    document.getElementById('add-item')?.addEventListener('click', () => {
      const clone = tmpl.content.firstElementChild!.cloneNode(true) as Element;
      list.appendChild(clone);
      bindRow(clone);
      recalc();
    });

    list.addEventListener('input', recalc);
    includeIva?.addEventListener('change', recalc);
    list.querySelectorAll('.orc-item').forEach(bindRow);
    recalc();
  }
</script>
