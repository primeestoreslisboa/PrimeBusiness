---
import { num } from '../lib/orcamentos';

export interface Props {
  action: string;
  actionName?: string | null;
  submitLabel: string;
  ivaRate: number;
  orc?: any;
  itens?: any[];
  prefill?: any;
  chamadoId?: string | number | null;
  chamadosAbertos?: any[];
  produtos?: any[];
}
const { action, actionName = null, submitLabel, ivaRate, orc = null, itens = [], prefill = null, chamadoId = null, chamadosAbertos = [], produtos = [] } = Astro.props;
const src = orc ?? prefill ?? {};
const selectedChamadoId = String(orc?.chamado_id ?? chamadoId ?? '');
const fmtChamadoOpt = (c: any) => {
  const dt = c.horario_agendado ? new Date(c.horario_agendado).toLocaleString('pt-PT', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Lisbon' }) : '';
  return `#${c.id} · ${c.nome}${c.cidade ? ` (${c.cidade})` : ''}${dt ? ` · ${dt}` : ''}`;
};

const includeIva = orc ? !!orc.include_iva : true;
const validade = orc ? (orc.validade_dias ?? 30) : 30;
const descontoTipo = orc?.desconto_tipo === 'percent' ? 'percent' : 'valor';
const descontoValor = orc ? num(orc.desconto_valor) : 0;
const rows = itens.length > 0 ? itens : [{ descricao: '', quantidade: 1, preco_unitario: '' }];
const inputCls = 'w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none';
---
<form method="POST" action={action} class="space-y-4" id="orc-form" data-iva-rate={ivaRate}>
  {actionName && <input type="hidden" name="action" value={actionName} />}

  <!-- DADOS DO CLIENTE -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3">
    <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wide">Dados do Cliente</h2>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Associar a agendamento (em aberto)</label>
      <select name="chamado_id" id="orc-chamado-select" class={inputCls}>
        <option value="">— Sem agendamento —</option>
        {chamadosAbertos.map((c: any) => (
          <option
            value={c.id}
            selected={String(c.id) === selectedChamadoId}
            data-nome={c.nome ?? ''}
            data-nif={c.nif ?? ''}
            data-telefone={c.telefone ?? ''}
            data-email={c.email ?? ''}
            data-morada={c.morada ?? ''}
            data-codigo_postal={c.codigo_postal ?? ''}
            data-localidade={c.cidade ?? ''}
          >{fmtChamadoOpt(c)}</option>
        ))}
      </select>
      <p class="text-xs text-gray-400 mt-1">Ao escolher um agendamento, os dados do cliente são carregados automaticamente.</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nome / Empresa *</label>
      <input type="text" name="cliente_nome" required value={src.cliente_nome ?? ''} class={inputCls} />
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">NIF / Contribuinte</label>
        <input type="text" name="cliente_nif" value={src.cliente_nif ?? ''} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Telefone</label>
        <input type="text" name="cliente_telefone" value={src.cliente_telefone ?? ''} class={inputCls} />
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
      <input type="text" name="cliente_email" inputmode="email" value={src.cliente_email ?? ''} placeholder="cliente@email.com; outro@email.com" class={inputCls} />
      <p class="text-xs text-gray-400 mt-1">Pode indicar vários emails separados por ponto e vírgula (;).</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Morada</label>
      <input type="text" name="cliente_morada" value={src.cliente_morada ?? ''} class={inputCls} />
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Cód. Postal</label>
        <input type="text" name="cliente_codigo_postal" value={src.cliente_codigo_postal ?? ''} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Localidade</label>
        <input type="text" name="cliente_localidade" value={src.cliente_localidade ?? ''} class={inputCls} />
      </div>
    </div>
  </div>

  <!-- PEÇAS E SERVIÇOS -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
    <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wide mb-3">Peças e Serviços</h2>
    <div id="itens-list" class="space-y-2">
      {rows.map((it: any) => (
        <div class="orc-item grid grid-cols-12 gap-2 items-start">
          {produtos.length > 0 && (
            <div class="col-span-12">
              <select class={`${inputCls} item-prod`}>
                <option value="">— Produto do catálogo (opcional) —</option>
                {produtos.map((p: any) => (
                  <option value={p.id} data-nome={p.nome} data-preco={p.venda} data-unidade={p.unidade}>{p.nome} — €{Number(p.venda).toFixed(2)}/{p.unidade}</option>
                ))}
              </select>
            </div>
          )}
          <div class="col-span-12 sm:col-span-6">
            <input type="text" name="item_desc" placeholder="Descrição da peça / serviço" value={it.descricao ?? ''} class={inputCls} />
          </div>
          <div class="col-span-3 sm:col-span-2">
            <input type="number" name="item_qtd" step="any" min="0" placeholder="Qtd" value={it.quantidade ?? 1} class={`${inputCls} item-qtd text-center`} />
          </div>
          <div class="col-span-5 sm:col-span-2">
            <input type="number" name="item_preco" step="0.01" min="0" placeholder="Preço €" value={it.preco_unitario ?? ''} class={`${inputCls} item-preco text-right`} />
          </div>
          <div class="col-span-3 sm:col-span-1 flex items-center h-full">
            <span class="item-total text-sm text-gray-600 w-full text-right">0,00</span>
          </div>
          <div class="col-span-1 flex items-center justify-end h-full">
            <button type="button" class="remove-item w-8 h-8 flex items-center justify-center rounded-lg bg-red-50 hover:bg-red-100 text-red-500" title="Remover">✕</button>
          </div>
        </div>
      ))}
    </div>
    <button type="button" id="add-item" class="mt-3 text-sm text-red-700 font-medium hover:underline">+ Adicionar linha</button>
  </div>

  <!-- TOTAIS / IVA -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3">
    <label class="flex items-center gap-2 text-sm text-gray-700">
      <input type="checkbox" name="include_iva" id="include-iva" checked={includeIva} class="w-4 h-4 accent-red-700" />
      Incluir IVA ({ivaRate}%)
    </label>
    <div class="flex items-center gap-2 pt-2 border-t border-gray-100">
      <label class="text-sm text-gray-700">Desconto</label>
      <input type="number" name="desconto_valor" id="desconto-valor" min="0" step="0.01" value={descontoValor || ''} placeholder="0"
             class="w-24 px-2 py-1.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
      <select name="desconto_tipo" id="desconto-tipo" class="px-2 py-1.5 border border-gray-300 rounded-lg text-sm bg-white">
        <option value="valor" selected={descontoTipo === 'valor'}>€</option>
        <option value="percent" selected={descontoTipo === 'percent'}>%</option>
      </select>
      <span class="text-xs text-gray-400">(sobre o valor sem IVA)</span>
    </div>
    <div class="text-sm space-y-1 pt-2 border-t border-gray-100">
      <div class="flex justify-between"><span class="text-gray-500">Subtotal</span><span id="sum-subtotal" class="font-medium text-gray-700">0,00 €</span></div>
      <div class="flex justify-between" id="sum-desconto-row"><span class="text-gray-500">Desconto</span><span id="sum-desconto" class="font-medium text-gray-700">0,00 €</span></div>
      <div class="flex justify-between" id="sum-iva-row"><span class="text-gray-500">IVA</span><span id="sum-iva" class="font-medium text-gray-700">0,00 €</span></div>
      <div class="flex justify-between text-base pt-1"><span class="font-bold text-gray-800">TOTAL</span><span id="sum-total" class="font-bold text-red-700">0,00 €</span></div>
    </div>
  </div>

  <!-- OPÇÕES -->
  <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3">
    {orc && (
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Estado</label>
        <select name="status" class={`${inputCls} max-w-[200px]`}>
          {['rascunho', 'enviado', 'aprovado', 'rejeitado'].map(s => (
            <option value={s} selected={orc.status === s}>
              {s === 'rascunho' ? 'Rascunho' : s === 'enviado' ? 'Enviado' : s === 'aprovado' ? 'Aprovado' : 'Rejeitado'}
            </option>
          ))}
        </select>
      </div>
    )}
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Validade (dias)</label>
      <input type="number" name="validade_dias" min="1" value={validade} class={`${inputCls} max-w-[120px]`} />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Observações</label>
      <textarea name="observacoes" rows="3" class={`${inputCls} resize-none`}>{orc?.observacoes ?? ''}</textarea>
    </div>
  </div>

  <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-xl transition">{submitLabel}</button>
</form>

<template id="item-template">
  <div class="orc-item grid grid-cols-12 gap-2 items-start">
    {produtos.length > 0 && (
      <div class="col-span-12">
        <select class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none bg-white item-prod">
          <option value="">— Produto do catálogo (opcional) —</option>
          {produtos.map((p: any) => (
            <option value={p.id} data-nome={p.nome} data-preco={p.venda} data-unidade={p.unidade}>{p.nome} — €{Number(p.venda).toFixed(2)}/{p.unidade}</option>
          ))}
        </select>
      </div>
    )}
    <div class="col-span-12 sm:col-span-6">
      <input type="text" name="item_desc" placeholder="Descrição da peça / serviço" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none" />
    </div>
    <div class="col-span-3 sm:col-span-2">
      <input type="number" name="item_qtd" step="any" min="0" placeholder="Qtd" value="1" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none item-qtd text-center" />
    </div>
    <div class="col-span-5 sm:col-span-2">
      <input type="number" name="item_preco" step="0.01" min="0" placeholder="Preço €" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 outline-none item-preco text-right" />
    </div>
    <div class="col-span-3 sm:col-span-1 flex items-center h-full">
      <span class="item-total text-sm text-gray-600 w-full text-right">0,00</span>
    </div>
    <div class="col-span-1 flex items-center justify-end h-full">
      <button type="button" class="remove-item w-8 h-8 flex items-center justify-center rounded-lg bg-red-50 hover:bg-red-100 text-red-500" title="Remover">✕</button>
    </div>
  </div>
</template>

<script>
  const form = document.getElementById('orc-form') as HTMLFormElement | null;
  if (form) {
    const ivaRate = parseFloat(form.dataset.ivaRate || '23') || 23;
    const list = document.getElementById('itens-list')!;
    const tmpl = document.getElementById('item-template') as HTMLTemplateElement;
    const includeIva = document.getElementById('include-iva') as HTMLInputElement;
    const fmt = (n: number) => new Intl.NumberFormat('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

    function recalc() {
      let subtotal = 0;
      list.querySelectorAll('.orc-item').forEach(row => {
        const q = parseFloat((row.querySelector('.item-qtd') as HTMLInputElement)?.value.replace(',', '.') || '0') || 0;
        const p = parseFloat((row.querySelector('.item-preco') as HTMLInputElement)?.value.replace(',', '.') || '0') || 0;
        const lineTotal = q * p;
        const cell = row.querySelector('.item-total');
        if (cell) cell.textContent = fmt(lineTotal);
        subtotal += lineTotal;
      });
      const descTipo = (document.getElementById('desconto-tipo') as HTMLSelectElement | null)?.value || 'valor';
      const descRaw = parseFloat(((document.getElementById('desconto-valor') as HTMLInputElement | null)?.value || '0').replace(',', '.')) || 0;
      let desconto = descTipo === 'percent' ? subtotal * (descRaw / 100) : descRaw;
      if (desconto < 0) desconto = 0;
      if (desconto > subtotal) desconto = subtotal;
      const base = subtotal - desconto;
      const ivaOn = includeIva?.checked;
      const iva = ivaOn ? base * (ivaRate / 100) : 0;
      const total = base + iva;
      document.getElementById('sum-subtotal')!.textContent = fmt(subtotal) + ' €';
      document.getElementById('sum-desconto')!.textContent = '- ' + fmt(desconto) + ' €';
      document.getElementById('sum-iva')!.textContent = fmt(iva) + ' €';
      document.getElementById('sum-total')!.textContent = fmt(total) + ' €';
      const ivaRow = document.getElementById('sum-iva-row');
      if (ivaRow) ivaRow.style.display = ivaOn ? '' : 'none';
      const descRow = document.getElementById('sum-desconto-row');
      if (descRow) descRow.style.display = desconto > 0 ? '' : 'none';
    }

    function bindRow(row: Element) {
      row.querySelector('.remove-item')?.addEventListener('click', () => {
        if (list.querySelectorAll('.orc-item').length > 1) {
          row.remove();
        } else {
          row.querySelectorAll('input').forEach(i => { (i as HTMLInputElement).value = (i as HTMLInputElement).name === 'item_qtd' ? '1' : ''; });
          const sel = row.querySelector('.item-prod') as HTMLSelectElement | null;
          if (sel) sel.value = '';
        }
        recalc();
      });

      // Ao escolher um produto do catálogo, preenche descrição e preço (deixa editável).
      const prod = row.querySelector('.item-prod') as HTMLSelectElement | null;
      prod?.addEventListener('change', () => {
        const opt = prod.selectedOptions[0];
        if (!opt || !prod.value) return;
        const desc = row.querySelector('[name="item_desc"]') as HTMLInputElement | null;
        const preco = row.querySelector('.item-preco') as HTMLInputElement | null;
        if (desc) desc.value = opt.dataset.nome || '';
        if (preco) preco.value = opt.dataset.preco || '';
        recalc();
      });
    }

    document.getElementById('add-item')?.addEventListener('click', () => {
      const clone = tmpl.content.firstElementChild!.cloneNode(true) as Element;
      list.appendChild(clone);
      bindRow(clone);
      recalc();
    });

    list.addEventListener('input', recalc);
    includeIva?.addEventListener('change', recalc);
    document.getElementById('desconto-valor')?.addEventListener('input', recalc);
    document.getElementById('desconto-tipo')?.addEventListener('change', recalc);
    list.querySelectorAll('.orc-item').forEach(bindRow);
    recalc();

    // Ao escolher um agendamento, carrega automaticamente os dados do cliente.
    const chamadoSelect = document.getElementById('orc-chamado-select') as HTMLSelectElement | null;
    function setField(name: string, value: string) {
      const el = form.querySelector(`[name="${name}"]`) as HTMLInputElement | null;
      if (el) el.value = value;
    }
    chamadoSelect?.addEventListener('change', () => {
      const opt = chamadoSelect.selectedOptions[0];
      const associar = !!chamadoSelect.value && !!opt;
      // Ao associar, carrega os dados do chamado; ao escolher "sem agendamento", limpa tudo.
      setField('cliente_nome', associar ? (opt.dataset.nome || '') : '');
      setField('cliente_nif', associar ? (opt.dataset.nif || '') : '');
      setField('cliente_telefone', associar ? (opt.dataset.telefone || '') : '');
      setField('cliente_email', associar ? (opt.dataset.email || '') : '');
      setField('cliente_morada', associar ? (opt.dataset.morada || '') : '');
      setField('cliente_codigo_postal', associar ? (opt.dataset.codigo_postal || '') : '');
      setField('cliente_localidade', associar ? (opt.dataset.localidade || '') : '');
    });
  }
</script>
