{
  "name": "primebussines",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "powershell -Command \"Remove-Item -Path 'node_modules/.vite' -Recurse -Force -ErrorAction SilentlyContinue\" && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:init": "node --env-file=.env scripts/db-init.mjs",
    "db:seed": "node --env-file=.env scripts/db-seed.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.3.0",
    "@astrojs/tailwind": "^5.1.0",
    "@neondatabase/serverless": "^0.10.4",
    "@types/nodemailer": "^7.0.11",
    "astro": "^5.6.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "nodemailer": "^8.0.4",
    "resend": "^4.1.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6"
  }
}
